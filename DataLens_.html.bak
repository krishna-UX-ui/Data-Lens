<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DataLens — CSV Analysis Studio</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>

:root{
  --paper:#F6F3EC;
  --paper-raised:#FFFFFF;
  --ink:#131B2E;
  --ink-soft:#3D4658;
  --ink-faint:#7C8598;
  --line:#DAD3C2;
  --brass:#B4813C;
  --brass-strong:#8F631F;
  --teal:#2F6F6B;
  --teal-strong:#1F4E4A;
  --danger:#B24C3B;
  --good:#3E7D5A;
  --warn:#C08A2E;
  --shadow: 0 1px 2px rgba(19,27,46,0.06), 0 8px 24px rgba(19,27,46,0.06);
  --radius: 10px;
  --font-display:'Fraunces', serif;
  --font-body:'Inter', sans-serif;
  --font-mono:'JetBrains Mono', monospace;
  --sidebar-w: 248px;
}
html[data-theme="dark"]{
  --paper:#12151C;
  --paper-raised:#191D26;
  --ink:#EDE9DF;
  --ink-soft:#B9BFCF;
  --ink-faint:#727A8C;
  --line:#2A2F3B;
  --brass:#D6A25C;
  --brass-strong:#E9BB7C;
  --teal:#5FA69E;
  --teal-strong:#7FC4BB;
  --danger:#E17A63;
  --good:#6FBF8E;
  --warn:#E0AE55;
  --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper); color:var(--ink); font-family:var(--font-body);
  font-size:14px; line-height:1.5; -webkit-font-smoothing:antialiased;
}
::selection{background:var(--brass); color:#fff;}
:focus-visible{outline:2px solid var(--brass); outline-offset:2px;}
h1,h2,h3,h4{font-family:var(--font-display); font-weight:600; margin:0; color:var(--ink);}
.mono{font-family:var(--font-mono);}
a{color:var(--teal);}
button{font-family:var(--font-body); cursor:pointer;}
::-webkit-scrollbar{width:10px; height:10px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--line); border-radius:6px;}

.aperture{display:inline-block; animation:none;}
.aperture.spin{animation:spin 1.6s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
@media (prefers-reduced-motion: reduce){ .aperture.spin{animation:none;} }

#app{display:flex; min-height:100vh;}
.sidebar{
  width:var(--sidebar-w); flex-shrink:0; background:var(--paper-raised);
  border-right:1px solid var(--line); position:fixed; top:0; left:0; bottom:0;
  display:flex; flex-direction:column; z-index:40; transition:transform .25s ease;
}
.brand{display:flex; align-items:center; gap:11px; padding:16px 16px 14px; border-bottom:1px solid var(--line);}
.brand-logo{width:48px;height:48px;object-fit:cover;border-radius:13px;flex-shrink:0;box-shadow:0 8px 22px rgba(0,0,0,.18);border:1px solid rgba(212,175,55,.28);background:#07111f;}
.brand-name{font-family:var(--font-display); font-size:19px; font-weight:700; letter-spacing:.2px;}
.brand-sub{font-size:10.5px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:1.4px; margin-top:1px;}
.nav{padding:10px 10px; overflow-y:auto; flex:1;}
.nav-item{
  display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:8px;
  color:var(--ink-soft); font-size:13.5px; font-weight:500; cursor:pointer; margin-bottom:2px;
  border:1px solid transparent; user-select:none;
}
.nav-item:hover{background:var(--paper); color:var(--ink);}
.nav-item.active{background:var(--ink); color:var(--paper);}
html[data-theme="dark"] .nav-item.active{background:var(--brass); color:#1a1206;}
.nav-item .dot{width:5px; height:5px; border-radius:50%; background:currentColor; opacity:.55; flex-shrink:0;}
.nav-section-label{font-size:10px; text-transform:uppercase; letter-spacing:1.2px; color:var(--ink-faint); padding:14px 12px 6px;}
.sidebar-foot{padding:12px 16px; border-top:1px solid var(--line); font-size:11px; color:var(--ink-faint);}

.main{margin-left:var(--sidebar-w); flex:1; min-width:0; display:flex; flex-direction:column;}
.topbar{
  position:sticky; top:0; z-index:30; background:var(--paper); border-bottom:1px solid var(--line);
  display:flex; align-items:center; justify-content:space-between; padding:12px 26px; gap:14px;
  backdrop-filter:blur(6px);
}
.topbar-left{display:flex; align-items:center; gap:12px; min-width:0;}
#menuToggle{display:none; background:none; border:1px solid var(--line); border-radius:8px; padding:6px 9px;}
.dataset-chip{display:flex; align-items:center; gap:8px; font-size:13px; color:var(--ink-soft); min-width:0;}
.dataset-chip .fname{font-weight:600; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:280px;}
.topbar-right{display:flex; align-items:center; gap:8px;}
.btn{
  border:1px solid var(--line); background:var(--paper-raised); color:var(--ink);
  padding:8px 14px; border-radius:8px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:7px;
  transition:transform .1s ease, border-color .15s ease;
}
.btn:hover{border-color:var(--ink-faint);}
.btn:active{transform:scale(.97);}
.btn.primary{background:var(--ink); color:var(--paper); border-color:var(--ink);}
html[data-theme="dark"] .btn.primary{background:var(--brass); color:#1a1206; border-color:var(--brass);}
.btn.accent{background:var(--teal); color:#fff; border-color:var(--teal);}
.btn.sm{padding:5px 10px; font-size:12px;}
.btn.ghost{background:transparent;}
.btn:disabled{opacity:.45; cursor:not-allowed;}
.icon-btn{border:1px solid var(--line); background:var(--paper-raised); border-radius:8px; width:34px; height:34px; display:flex; align-items:center; justify-content:center;}

.content{padding:24px 26px 60px; max-width:1400px; width:100%; margin:0 auto;}
.panel{display:none;}
.panel.active{display:block; animation:fadein .2s ease;}
@keyframes fadein{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;}}

.page-head{margin-bottom:18px;}
.page-eyebrow{font-size:11px; text-transform:uppercase; letter-spacing:1.6px; color:var(--brass-strong); font-weight:700; margin-bottom:4px;}
.page-title{font-size:26px;}
.page-desc{color:var(--ink-soft); margin-top:6px; font-size:13.5px; max-width:760px;}

.grid{display:grid; gap:14px;}
.grid.cols-4{grid-template-columns:repeat(4,1fr);}
.grid.cols-3{grid-template-columns:repeat(3,1fr);}
.grid.cols-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:1000px){.grid.cols-4{grid-template-columns:repeat(2,1fr);} .grid.cols-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.grid.cols-4,.grid.cols-3,.grid.cols-2{grid-template-columns:1fr;}}

.card{background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; box-shadow:var(--shadow);}
.card h3{font-size:14.5px;}
.stat-card{padding:16px 18px;}
.stat-label{font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--ink-faint); font-weight:600;}
.stat-value{font-family:var(--font-display); font-size:28px; margin-top:4px; font-weight:700;}
.stat-sub{font-size:11.5px; color:var(--ink-faint); margin-top:3px;}

.section-title{display:flex; align-items:center; justify-content:space-between; margin:28px 0 12px;}
.section-title h2{font-size:17px;}
.section-title .hint{font-size:12px; color:var(--ink-faint);}

.dropzone{
  border:2px dashed var(--line); border-radius:14px; padding:56px 24px; text-align:center;
  background:var(--paper-raised); transition:border-color .15s, background .15s; cursor:pointer;
}
.dropzone.drag{border-color:var(--brass); background:rgba(180,129,60,0.06);}
.dropzone h3{font-size:19px; margin-bottom:6px;}
.dropzone p{color:var(--ink-faint); font-size:13px; margin:4px 0 18px;}

.progress-track{height:6px; background:var(--line); border-radius:4px; overflow:hidden; margin-top:10px;}
.progress-fill{height:100%; background:var(--teal); width:0%; transition:width .2s ease;}

.badge{display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; padding:3px 8px; border-radius:20px; border:1px solid var(--line); color:var(--ink-soft); background:var(--paper);}
.badge.num{color:var(--teal-strong); border-color:var(--teal);}
.badge.cat{color:var(--brass-strong); border-color:var(--brass);}
.badge.date{color:#6E5AA6; border-color:#B7A6E0;}
.badge.bool{color:var(--good); border-color:var(--good);}
.badge.text{color:var(--ink-faint);}
.badge.id{color:var(--danger); border-color:var(--danger);}
.badge.warn{color:var(--warn); border-color:var(--warn);}

table.dl-table{width:100%; border-collapse:collapse; font-size:12.5px;}
table.dl-table th{text-align:left; font-size:10.5px; text-transform:uppercase; letter-spacing:.6px; color:var(--ink-faint); border-bottom:1px solid var(--line); padding:8px 10px; position:sticky; top:0; background:var(--paper-raised);}
table.dl-table td{padding:7px 10px; border-bottom:1px solid var(--line); white-space:nowrap;}
table.dl-table tr:hover td{background:var(--paper);}
.table-scroll{overflow:auto; max-height:520px; border:1px solid var(--line); border-radius:var(--radius);}
td.missing-cell{background:rgba(178,76,59,0.12); color:var(--danger); font-style:italic;}
td.outlier-cell{background:rgba(192,138,46,0.16); font-weight:700;}

.tag-row{display:flex; flex-wrap:wrap; gap:6px;}
.pill-select{border:1px solid var(--line); background:var(--paper-raised); border-radius:8px; padding:8px 10px; font-size:13px; color:var(--ink); font-family:var(--font-body); width:100%;}
label.field-label{font-size:11px; text-transform:uppercase; letter-spacing:.8px; color:var(--ink-faint); font-weight:700; display:block; margin-bottom:5px;}
.field{margin-bottom:14px;}

.insight-card{display:flex; gap:12px; padding:14px 16px; border:1px solid var(--line); border-radius:10px; background:var(--paper-raised); margin-bottom:10px;}
.insight-icon{width:30px; height:30px; border-radius:8px; background:var(--teal); color:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:15px;}
.insight-icon.warn{background:var(--warn);}
.insight-icon.good{background:var(--good);}
.insight-icon.info{background:var(--brass);}
.insight-text{font-size:13.5px; line-height:1.55;}
.insight-metric{font-family:var(--font-mono); font-size:11.5px; color:var(--ink-faint); margin-top:4px;}

.empty-state{text-align:center; padding:70px 20px; color:var(--ink-faint);}
.empty-state h3{color:var(--ink); margin-bottom:6px; font-size:17px;}

.toast-wrap{position:fixed; bottom:20px; right:20px; z-index:200; display:flex; flex-direction:column; gap:8px;}
.toast{background:var(--ink); color:var(--paper); padding:11px 16px; border-radius:9px; font-size:13px; box-shadow:var(--shadow); display:flex; align-items:center; gap:9px; animation:toastin .2s ease; max-width:320px;}
html[data-theme="dark"] .toast{background:var(--brass); color:#1a1206;}
.toast.err{background:var(--danger); color:#fff;}
@keyframes toastin{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;}}

.skeleton{background:linear-gradient(90deg, var(--line) 25%, var(--paper) 50%, var(--line) 75%); background-size:200% 100%; animation:shimmer 1.4s infinite; border-radius:8px;}
@keyframes shimmer{from{background-position:200% 0;} to{background-position:-200% 0;}}

.modal-backdrop{position:fixed; inset:0; background:rgba(19,27,46,0.5); z-index:100; display:flex; align-items:center; justify-content:center; padding:20px;}
.modal{background:var(--paper-raised); border-radius:14px; max-width:640px; width:100%; max-height:85vh; overflow:auto; padding:22px 24px; box-shadow:var(--shadow);}
.modal h3{margin-bottom:12px;}

.check-row{display:flex; align-items:flex-start; gap:10px; padding:9px 0; border-bottom:1px solid var(--line);}
.check-row:last-child{border-bottom:none;}
.check-row input{margin-top:3px;}
.check-row .ct-title{font-size:13px; font-weight:600;}
.check-row .ct-desc{font-size:12px; color:var(--ink-faint); margin-top:1px;}

.theme-toggle{display:flex; border:1px solid var(--line); border-radius:8px; overflow:hidden;}
.theme-toggle button{border:none; background:var(--paper-raised); padding:7px 10px; color:var(--ink-faint); font-size:12px;}
.theme-toggle button.active{background:var(--ink); color:var(--paper);}
html[data-theme="dark"] .theme-toggle button.active{background:var(--brass); color:#1a1206;}

.tabs{display:flex; gap:4px; border-bottom:1px solid var(--line); margin-bottom:16px; flex-wrap:wrap;}
.tab{padding:8px 14px; font-size:13px; font-weight:600; color:var(--ink-faint); border-bottom:2px solid transparent; cursor:pointer;}
.tab.active{color:var(--ink); border-color:var(--brass);}

.corr-table{border-collapse:collapse; font-size:11px;}
.corr-table td, .corr-table th{width:52px; height:34px; text-align:center; font-family:var(--font-mono);}
.corr-table th{font-size:10px; color:var(--ink-faint); font-weight:600;}

.filter-row{display:flex; gap:8px; align-items:center; margin-bottom:8px; flex-wrap:wrap;}
.small-input{border:1px solid var(--line); background:var(--paper-raised); border-radius:7px; padding:6px 9px; font-size:12.5px; font-family:var(--font-body);}

.full-data-table{min-width:max-content;}
.full-data-table th,.full-data-table td{white-space:nowrap;max-width:320px;overflow:hidden;text-overflow:ellipsis;}
.full-data-table .row-number{position:sticky;left:0;background:var(--paper-raised);font-family:var(--font-mono);color:var(--ink-faint);z-index:2;}
.dataset-table-wrap{max-width:100%;overflow:hidden;}

@media(max-width:900px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:none;}
  .main{margin-left:0;}
  #menuToggle{display:flex;}
  .grid.cols-4,.grid.cols-3{grid-template-columns:repeat(2,1fr);}
}
</style>

<style id="enhanced-ui">
.dataset-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:12px 0}.dataset-toolbar input{min-width:220px}.column-picker{max-height:260px;overflow:auto;padding:10px;border:1px solid var(--border);border-radius:12px;background:var(--card)}.column-picker label{display:flex;gap:8px;padding:5px 0;font-size:12px}.quality-alerts{display:grid;gap:8px;margin:14px 0}.quality-alert{padding:10px 12px;border:1px solid var(--border);border-radius:10px;font-size:12.5px;background:var(--card)}.version-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.version-tabs button{padding:8px 12px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--ink);cursor:pointer}.version-tabs button.active{font-weight:700}.clean-history{margin-top:18px}.history-item{padding:9px 11px;border-left:3px solid var(--accent);margin:6px 0;background:var(--card);font-size:12px}.health-ring{font-size:42px;font-weight:800;letter-spacing:-2px}.col-card{cursor:pointer}.col-card:hover{transform:translateY(-2px)}
</style>

<style id="datalens-neon-theme">
:root{
  --paper:#050B14;--paper-raised:#0A1422;--ink:#F1F5F9;--ink-soft:#A9B7CC;--ink-faint:#70819A;
  --line:rgba(96,165,250,.16);--brass:#F5B942;--brass-strong:#FFD36B;--teal:#22D3EE;--teal-strong:#67E8F9;
  --danger:#FB7185;--good:#34D399;--warn:#F59E0B;--accent:#3B82F6;--border:rgba(96,165,250,.16);--card:#0A1422;
  --shadow:0 16px 50px rgba(0,0,0,.28);--radius:16px;--font-display:'Inter',sans-serif;
}

body{background:radial-gradient(circle at 80% -10%,rgba(30,64,175,.13),transparent 32%),#050B14;color:var(--ink);}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(56,189,248,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(56,189,248,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 55%);}
.sidebar{background:linear-gradient(180deg,#07111E 0%,#050B14 100%);border-right:1px solid rgba(96,165,250,.14);box-shadow:20px 0 60px rgba(0,0,0,.18);}
.brand{padding:24px 20px 20px;gap:12px;border-bottom:1px solid rgba(96,165,250,.12);}
.brand-logo{width:54px!important;height:54px!important;border-radius:15px!important;object-fit:cover!important;border:1px solid rgba(34,211,238,.34)!important;box-shadow:0 0 0 1px rgba(245,185,66,.12),0 12px 30px rgba(0,0,0,.42)!important;background:#07111f!important;}
.brand-name{font-family:'Inter',sans-serif!important;font-weight:800!important;letter-spacing:.6px!important;font-size:20px!important;background:linear-gradient(90deg,#F5B942,#67E8F9,#3B82F6);-webkit-background-clip:text;background-clip:text;color:transparent;}
.brand-sub{font-size:8px!important;color:#D8B866!important;letter-spacing:1.15px!important;white-space:nowrap;}
.nav{padding:18px 12px;}.nav-item{border-radius:12px;padding:11px 13px;margin-bottom:5px;color:#AAB9CE;transition:.2s ease;}
.nav-item:hover{background:rgba(59,130,246,.08);color:#F8FAFC;border-color:rgba(96,165,250,.12);transform:translateX(2px);}
.nav-item.active{background:linear-gradient(90deg,rgba(37,99,235,.34),rgba(14,165,233,.08))!important;color:#F8FAFC!important;border:1px solid rgba(56,189,248,.35)!important;box-shadow:inset 0 0 18px rgba(37,99,235,.12),0 6px 20px rgba(0,0,0,.18);}
.nav-item .dot{width:7px;height:7px;background:#60A5FA;opacity:1;box-shadow:0 0 12px #60A5FA;}.nav-section-label{color:#60718A;}
.sidebar-foot{border-top-color:rgba(96,165,250,.12);color:#63738A;padding:16px 20px;font-size:10px;}
.topbar{background:rgba(5,11,20,.82);backdrop-filter:blur(18px);border-bottom:1px solid rgba(96,165,250,.13);padding:16px 28px;}
.dataset-chip{background:rgba(10,20,34,.72);border:1px solid rgba(96,165,250,.13);padding:8px 12px;border-radius:12px;}
.dataset-chip .fname{color:#DCE8F7;}.btn{background:linear-gradient(180deg,rgba(18,31,50,.96),rgba(9,19,33,.96));border-color:rgba(96,165,250,.2);color:#DCE8F7;border-radius:11px;box-shadow:0 8px 20px rgba(0,0,0,.14);}
.btn:hover{border-color:rgba(56,189,248,.55);box-shadow:0 0 22px rgba(37,99,235,.14);}.btn.primary,.btn.accent{background:linear-gradient(135deg,#2563EB,#0EA5E9)!important;border-color:#3B82F6!important;color:#fff!important;}
.content{max-width:1540px;padding:28px 30px 60px;}.page-head{margin-bottom:20px;}.page-title{font-size:31px;font-weight:800;letter-spacing:-.8px;}.page-eyebrow{color:#67E8F9;}.page-desc{color:#91A1B7;}
.dashboard-logo{width:40px!important;height:40px!important;object-fit:cover;border-radius:12px;border:1px solid rgba(245,185,66,.3);box-shadow:0 8px 24px rgba(0,0,0,.25);}
.dashboard-welcome{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);min-height:250px;margin:0 0 24px;border:1px solid rgba(56,189,248,.25);border-radius:22px;background:radial-gradient(circle at 82% 20%,rgba(37,99,235,.22),transparent 30%),linear-gradient(135deg,rgba(8,20,36,.98),rgba(4,12,23,.96));box-shadow:0 20px 60px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.03);}
.dashboard-welcome:after{content:"";position:absolute;right:-8%;bottom:-55%;width:58%;height:130%;border:1px solid rgba(59,130,246,.18);border-radius:50%;transform:rotate(-14deg);}
.welcome-copy{position:relative;z-index:2;padding:38px 42px;display:flex;flex-direction:column;justify-content:center;}.welcome-kicker{font-size:10px;letter-spacing:1.8px;color:#67E8F9;font-weight:800;margin-bottom:10px;display:flex;align-items:center;gap:8px}.welcome-kicker span{width:18px;height:2px;background:#F5B942;box-shadow:0 0 12px #F5B942;}
.welcome-copy h2{font-size:42px;line-height:1.08;font-family:'Inter',sans-serif;font-weight:800;letter-spacing:-1.4px;}.welcome-copy h2 em{font-style:normal;background:linear-gradient(90deg,#67E8F9,#60A5FA,#A78BFA);-webkit-background-clip:text;background-clip:text;color:transparent;}.welcome-copy p{max-width:700px;color:#9CACBF;font-size:14px;line-height:1.75;margin:13px 0 18px;}.welcome-tags{display:flex;flex-wrap:wrap;gap:8px}.welcome-tags span{font-size:10.5px;color:#BFD7F5;border:1px solid rgba(96,165,250,.18);background:rgba(59,130,246,.07);padding:6px 10px;border-radius:999px;}
.welcome-visual{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;min-height:250px}.welcome-visual img{width:230px;height:230px;object-fit:cover;border-radius:50%;mix-blend-mode:screen;filter:drop-shadow(0 18px 40px rgba(34,211,238,.16));opacity:.92}.glow-ring{position:absolute;border-radius:50%;border:1px solid rgba(56,189,248,.18)}.ring-a{width:230px;height:230px;box-shadow:0 0 45px rgba(37,99,235,.15)}.ring-b{width:280px;height:280px;border-color:rgba(245,185,66,.12)}
.dropzone{border:1.5px dashed rgba(96,165,250,.32);border-radius:18px;background:linear-gradient(145deg,rgba(12,27,47,.86),rgba(7,16,29,.96));box-shadow:var(--shadow);}.dropzone.drag{border-color:#22D3EE;background:rgba(14,165,233,.08);}.dropzone h3{font-family:'Inter',sans-serif;font-weight:750;}.card,.insight-card,.quality-alert,.history-item{background:linear-gradient(145deg,rgba(13,26,44,.94),rgba(8,17,30,.94));border-color:rgba(96,165,250,.14);border-radius:16px;box-shadow:0 12px 30px rgba(0,0,0,.14);}.card{position:relative;overflow:hidden;}.card:before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(103,232,249,.45),transparent);}.stat-label{color:#8292A8;}.stat-value{font-family:'Inter',sans-serif;font-weight:800;color:#EEF6FF;}.section-title{margin-top:30px}.section-title h2{font-family:'Inter',sans-serif;font-size:18px;font-weight:750;}.table-scroll{border-color:rgba(96,165,250,.14);background:#091321;border-radius:14px;}.table-scroll table th{background:#0B1726;color:#7F92AA}.table-scroll table td{border-bottom-color:rgba(96,165,250,.09);}.table-scroll table tr:hover td{background:rgba(59,130,246,.06);}.badge{background:rgba(13,26,44,.8);border-color:rgba(96,165,250,.2);}.empty-state{border:1px dashed rgba(96,165,250,.18);border-radius:18px;background:rgba(10,20,34,.48);}.theme-toggle{border-color:rgba(96,165,250,.2);border-radius:10px}.theme-toggle button{background:#0A1422;color:#7F91A8}.theme-toggle button.active{background:linear-gradient(135deg,#2563EB,#0EA5E9)!important;color:#fff!important}.toast{background:#0B1726;border:1px solid rgba(96,165,250,.18);color:#EAF3FF;}
@media(max-width:900px){.dashboard-welcome{grid-template-columns:1fr}.welcome-visual{display:none}.content{padding:20px}.topbar{padding:12px 16px}.brand{padding-top:16px}}
@media(max-width:560px){.welcome-copy{padding:28px 22px}.welcome-copy h2{font-size:32px}.topbar-right .theme-toggle{display:none}.dataset-chip{max-width:170px}}
</style>
</head>
<body>

<div id="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <img class="brand-logo" src="data:image/png;base64," alt="DataLens logo">
      <div>
        <div class="brand-name">DataLens</div>
        <div class="brand-sub">CSV Analysis Studio</div>
      </div>
    </div>
    <nav class="nav" id="navList">
      <div class="nav-item active" data-panel="dashboard"><span class="dot"></span>Dashboard</div>
      <div class="nav-item" data-panel="dataset"><span class="dot"></span>Dataset</div>
      <div class="nav-item" data-panel="cleaning"><span class="dot"></span>Data Cleaning</div>
      <div class="nav-item" data-panel="stats"><span class="dot"></span>Statistics</div>
      <div class="nav-item" data-panel="outliers"><span class="dot"></span>Outliers</div>
      <div class="nav-item" data-panel="insights"><span class="dot"></span>AI Insights</div>
      <div class="nav-item" data-panel="ml"><span class="dot"></span>Machine Learning</div>
      <div class="nav-item" data-panel="table"><span class="dot"></span>Data Table</div>
      <div class="nav-item" data-panel="reports"><span class="dot"></span>Reports</div>
      <div class="nav-item" data-panel="downloads"><span class="dot"></span>Downloads</div>
      <div class="nav-item" data-panel="settings"><span class="dot"></span>Settings</div>
    </nav>
    <div class="sidebar-foot">No data leaves your browser — everything runs locally.</div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div class="topbar-left">
        <button id="menuToggle" class="icon-btn" aria-label="Toggle menu">☰</button>
        <div class="dataset-chip">
          <span class="fname" id="topFileName">No dataset loaded</span>
          <span class="badge" id="topFileMeta" style="display:none;"></span>
        </div>
      </div>
      <div class="topbar-right">
        <button class="btn" id="quickDownloadBtn" disabled>⤓ Download</button>
      </div>
    </div>

    <div class="content">

      <section class="panel active" id="panel-dashboard">
        <div class="page-head">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
            <img class="dashboard-logo" src="data:image/png;base64," alt="DataLens logo">
            <div class="page-eyebrow" style="margin:0;">Overview</div>
          </div>
          <h1 class="page-title">Dashboard</h1>
          <p class="page-desc">Upload a CSV to automatically profile it: types, quality, distributions, outliers and plain-language findings — all computed from your actual data.</p>
        </div>


        <div class="dashboard-welcome">
          <div class="welcome-copy">
            <div class="welcome-kicker"><span></span> INTELLIGENT DATA ANALYSIS</div>
            <h2>Welcome to <em>DataLens</em></h2>
            <p>See data. Understand better. Decide smarter. Upload your dataset and transform raw information into clear, actionable intelligence.</p>
            <div class="welcome-tags"><span>CSV Analysis</span><span>Data Cleaning</span><span>Statistics</span><span>Machine Learning</span></div>
          </div>
          <div class="welcome-visual">
            <img src="data:image/png;base64," alt="DataLens">
            <div class="glow-ring ring-a"></div><div class="glow-ring ring-b"></div>
          </div>
        </div>
        <div id="dashUploadWrap">
          <div class="dropzone" id="dropzone">
            <svg class="aperture" width="44" height="44" viewBox="0 0 40 40" fill="none" style="margin-bottom:12px;">
              <circle cx="20" cy="20" r="18" stroke="var(--brass)" stroke-width="1.4"/>
              <g stroke="var(--brass)" stroke-width="1.4" fill="var(--brass)" fill-opacity="0.12">
                <path d="M20 6 L26 16 L20 20 Z"/><path d="M34 20 L24 26 L20 20 Z"/>
                <path d="M20 34 L14 24 L20 20 Z"/><path d="M6 20 L16 14 L20 20 Z"/>
              </g>
            </svg>
            <h3>Drop a CSV file here</h3>
            <p>or browse your computer · large files are parsed in chunks</p>
            <button class="btn primary" id="browseBtn">Browse files</button>
            <input type="file" id="fileInput" accept=".csv,text/csv" style="display:none;">
            <div id="uploadProgressWrap" style="display:none; max-width:340px; margin:16px auto 0;">
              <div class="progress-track"><div class="progress-fill" id="uploadProgressFill"></div></div>
              <div style="font-size:11.5px; color:var(--ink-faint); margin-top:6px;" id="uploadProgressLabel">Reading file…</div>
            </div>
            <div id="uploadError" style="display:none; color:var(--danger); font-size:12.5px; margin-top:14px;"></div>
          </div>
        </div>

        <div id="dashLoaded" style="display:none;">
          <div class="grid cols-4" id="overviewCards"></div>

          <div class="section-title"><h2>Column Profile</h2><span class="hint" id="colProfileHint"></span></div>
          <div class="table-scroll"><table class="dl-table" id="columnProfileTable"></table></div>

          <div class="section-title"><h2>Top Insights</h2><span class="hint">See full list under AI Insights</span></div>
          <div id="dashInsights"></div>

          <div style="margin-top:24px; display:flex; gap:10px;">
            <button class="btn" id="replaceDatasetBtn">↺ Replace dataset</button>
          </div>
        </div>
      </section>

      <section class="panel" id="panel-dataset">
        <div class="page-head">
          <div class="page-eyebrow">Inspection</div>
          <h1 class="page-title">Dataset</h1>
          <p class="page-desc">Detected structure of the uploaded file.</p>
        </div>
        <div id="datasetPanelBody"><div class="empty-state"><h3>No dataset yet</h3><p>Upload a CSV from the Dashboard tab.</p></div></div>
      </section>

      <section class="panel" id="panel-cleaning">
        <div class="page-head">
          <div class="page-eyebrow">Quality</div>
          <h1 class="page-title">Data Cleaning</h1>
          <p class="page-desc">Nothing is changed automatically. Review suggested actions, preview the effect, then apply. The original dataset is always kept.</p>
        </div>
        <div id="cleaningPanelBody"><div class="empty-state"><h3>No dataset yet</h3><p>Upload a CSV from the Dashboard tab.</p></div></div>
      </section>

      <section class="panel" id="panel-stats">
        <div class="page-head">
          <div class="page-eyebrow">Analysis</div>
          <h1 class="page-title">Statistics</h1>
          <p class="page-desc">Descriptive statistics for every column, computed on the currently active dataset (cleaned if applied, otherwise original).</p>
        </div>
        <div id="statsPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-outliers">
        <div class="page-head">
          <div class="page-eyebrow">Quality</div>
          <h1 class="page-title">Outliers</h1>
          <p class="page-desc">Flagged using the IQR method (1.5×IQR fences) with z-score shown for reference. An outlier may still be a valid observation — nothing is removed automatically.</p>
        </div>
        <div id="outliersPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-insights">
        <div class="page-head">
          <div class="page-eyebrow">Narrative</div>
          <h1 class="page-title">AI Insights</h1>
          <p class="page-desc">Plain-language findings generated from the dataset's actual computed statistics — every claim below is backed by a number.</p>
        </div>
        <div id="insightsPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-ml">
        <div class="page-head">
          <div class="page-eyebrow">Modeling</div>
          <h1 class="page-title">Machine Learning</h1>
          <p class="page-desc">Pick a target column. DataLens fits a simple baseline model on a train/test split and reports honest performance metrics — it will tell you plainly when prediction isn't advisable.</p>
        </div>
        <div id="mlPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-table">
        <div class="page-head">
          <div class="page-eyebrow">Explore</div>
          <h1 class="page-title">Data Table</h1>
          <p class="page-desc">Search, sort, filter and export the row-level data.</p>
        </div>
        <div id="tablePanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-reports">
        <div class="page-head">
          <div class="page-eyebrow">Export</div>
          <h1 class="page-title">Reports</h1>
          <p class="page-desc">Generate a formatted PDF report covering the whole analysis.</p>
        </div>
        <div id="reportsPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-downloads">
        <div class="page-head">
          <div class="page-eyebrow">Export</div>
          <h1 class="page-title">Downloads</h1>
          <p class="page-desc">Export individual artifacts, or everything as one ZIP package.</p>
        </div>
        <div id="downloadsPanelBody"><div class="empty-state"><h3>No dataset yet</h3></div></div>
      </section>

      <section class="panel" id="panel-settings">
        <div class="page-head">
          <div class="page-eyebrow">Preferences</div>
          <h1 class="page-title">Settings</h1>
        </div>
        <div class="card" style="max-width:480px;">
          <h3 style="margin-bottom:10px;">Appearance</h3>
          <div style="display:flex;align-items:center;gap:10px;color:var(--ink-soft);font-size:13px;">
            <span style="width:10px;height:10px;border-radius:50%;background:var(--teal);box-shadow:0 0 14px rgba(34,211,238,.7);"></span>
            <span>Permanent Dark Theme</span>
          </div>
          <p style="font-size:12px; color:var(--ink-faint); margin-top:14px;">DataLens uses a fixed premium dark interface for a consistent visual experience.</p>
        </div>
        <div class="card" style="max-width:480px; margin-top:14px;">
          <h3 style="margin-bottom:8px;">About</h3>
          <p style="font-size:12.5px; color:var(--ink-soft);">DataLens parses and analyzes CSV files entirely client-side. Optional AI-written insights call the Claude API; if unreachable, DataLens falls back to its built-in rule-based narrative generator so insights are always available.</p>
        </div>
      </section>

    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>

<script>
"use strict";

const STATE = {
  fileName: null,
  fileSize: 0,
  rawRows: [],          // array of row objects, values as parsed strings/typed
  columns: [],           // column meta [{name, type, ...}]
  originalRows: [],      // typed original rows (array of objects)
  cleanedRows: null,     // typed cleaned rows, or null if not applied
  cleaningApplied: false,
  cleaningPlan: null,    // computed suggestions
  cleaningSummary: null,
  outlierReport: null,
  insights: [],
  mlResult: null,
  tableView: { page: 1, pageSize: 25, sortCol: null, sortDir: 1, search: '', source: 'cleaned' },
};

function activeRows(){
  return (STATE.cleaningApplied && STATE.cleanedRows) ? STATE.cleanedRows : STATE.originalRows;
}
function numericCols(){ return STATE.columns.filter(c=>c.type==='numeric').map(c=>c.name); }
function categoricalCols(){ return STATE.columns.filter(c=>c.type==='categorical'||c.type==='boolean').map(c=>c.name); }
function dateCols(){ return STATE.columns.filter(c=>c.type==='date').map(c=>c.name); }
function colMeta(name){ return STATE.columns.find(c=>c.name===name); }

function toast(msg, kind){
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className = 'toast' + (kind==='err' ? ' err' : '');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(), 300); }, 3200);
}
function fmtNum(n, d=2){
  if(n===null||n===undefined||Number.isNaN(n)) return '—';
  if(Math.abs(n) >= 1000) return Number(n).toLocaleString(undefined,{maximumFractionDigits:d});
  return Number(n.toFixed(d)).toString();
}
function fmtPct(n,d=1){ if(n===null||n===undefined||Number.isNaN(n)) return '—'; return n.toFixed(d)+'%'; }
function fmtBytes(b){ if(b<1024) return b+' B'; if(b<1024*1024) return (b/1024).toFixed(1)+' KB'; return (b/1024/1024).toFixed(2)+' MB'; }
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function download(filename, content, mime){
  const blob = new Blob([content], {type:mime||'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=filename; document.body.appendChild(a); a.click();
  a.remove(); setTimeout(()=>URL.revokeObjectURL(url), 2000);
}
function downloadBlob(filename, blob){
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=filename; document.body.appendChild(a); a.click();
  a.remove(); setTimeout(()=>URL.revokeObjectURL(url), 2000);
}

const S = {
  mean(a){ return a.length ? a.reduce((x,y)=>x+y,0)/a.length : NaN; },
  variance(a){ if(a.length<2) return NaN; const m=S.mean(a); return a.reduce((s,v)=>s+(v-m)**2,0)/(a.length-1); },
  std(a){ return Math.sqrt(S.variance(a)); },
  sorted(a){ return [...a].sort((x,y)=>x-y); },
  percentile(sortedArr, p){
    if(!sortedArr.length) return NaN;
    const idx = (p/100)*(sortedArr.length-1);
    const lo = Math.floor(idx), hi = Math.ceil(idx);
    if(lo===hi) return sortedArr[lo];
    return sortedArr[lo] + (sortedArr[hi]-sortedArr[lo])*(idx-lo);
  },
  median(a){ const s=S.sorted(a); return S.percentile(s,50); },
  mode(a){
    const freq = new Map();
    a.forEach(v=>freq.set(v,(freq.get(v)||0)+1));
    let best=null, bestC=-1;
    freq.forEach((c,v)=>{ if(c>bestC){bestC=c; best=v;} });
    return best;
  },
  min(a){ return a.length? Math.min(...a): NaN; },
  max(a){ return a.length? Math.max(...a): NaN; },
  pearson(x,y){
    const n = Math.min(x.length,y.length);
    if(n<2) return NaN;
    const mx=S.mean(x), my=S.mean(y);
    let num=0, dx=0, dy=0;
    for(let i=0;i<n;i++){ num += (x[i]-mx)*(y[i]-my); dx += (x[i]-mx)**2; dy += (y[i]-my)**2; }
    if(dx===0||dy===0) return NaN;
    return num/Math.sqrt(dx*dy);
  }
};

const dropzone = document.getElementById('dropzone');
const fileInput = document.getElementById('fileInput');
document.getElementById('browseBtn').addEventListener('click', ()=>fileInput.click());
['dragenter','dragover'].forEach(ev=>dropzone.addEventListener(ev, e=>{ e.preventDefault(); dropzone.classList.add('drag'); }));
['dragleave','drop'].forEach(ev=>dropzone.addEventListener(ev, e=>{ e.preventDefault(); dropzone.classList.remove('drag'); }));
dropzone.addEventListener('drop', e=>{
  const f = e.dataTransfer.files[0];
  if(f) handleFile(f);
});
dropzone.addEventListener('click', (e)=>{ if(e.target.id==='browseBtn') return; fileInput.click(); });
fileInput.addEventListener('change', e=>{ if(e.target.files[0]) handleFile(e.target.files[0]); });
document.getElementById('replaceDatasetBtn')?.addEventListener('click', ()=>{
  document.getElementById('dashLoaded').style.display='none';
  document.getElementById('dashUploadWrap').style.display='block';
  fileInput.value='';
});

function showUploadError(msg){
  const el = document.getElementById('uploadError');
  el.style.display='block'; el.textContent = msg;
}

function handleFile(file){
  document.getElementById('uploadError').style.display='none';
  if(!/\.csv$/i.test(file.name) && file.type!=='text/csv'){
    showUploadError("That file doesn't look like a CSV. Please upload a .csv file."); return;
  }
  if(file.size===0){ showUploadError('This file is empty.'); return; }
  const progWrap = document.getElementById('uploadProgressWrap');
  const progFill = document.getElementById('uploadProgressFill');
  const progLabel = document.getElementById('uploadProgressLabel');
  progWrap.style.display='block'; progFill.style.width='4%'; progLabel.textContent='Reading file…';

  STATE.fileName = file.name; STATE.fileSize = file.size;

  const parsedRows = [];
  let parsedFields = [];
  let parsedErrors = [];
  let parsedDelimiter = ',';

  Papa.parse(file, {
    header: true,
    dynamicTyping: false,
    skipEmptyLines: 'greedy',
    worker: true,
    chunk: function(chunkResult){
      if(chunkResult && Array.isArray(chunkResult.data)){
        parsedRows.push(...chunkResult.data);
      }
      if(chunkResult && Array.isArray(chunkResult.errors)){
        parsedErrors.push(...chunkResult.errors);
      }
      if(chunkResult && chunkResult.meta){
        if(Array.isArray(chunkResult.meta.fields) && chunkResult.meta.fields.length){
          parsedFields = chunkResult.meta.fields.slice();
        }
        if(chunkResult.meta.delimiter) parsedDelimiter = chunkResult.meta.delimiter;
      }
      progFill.style.width = '55%';
      progLabel.textContent = 'Parsing rows…';
    },
    complete: function(){
      progFill.style.width='80%';
      progLabel.textContent='Detecting column types…';
      try{
        const fields = parsedFields;
        const rows = parsedRows.filter(r =>
          r && fields.some(f => r[f]!==undefined && String(r[f]).trim()!=='')
        );

        const fatalErrors = parsedErrors.filter(e =>
          e && (e.type === 'Delimiter' || e.type === 'Quotes')
        );

        if(fatalErrors.length && rows.length === 0){
          showUploadError('Could not parse this CSV — it may be corrupted or use an unsupported format.');
          progWrap.style.display='none';
          return;
        }
        if(fields.length===0){
          showUploadError('No columns detected in this file.');
          progWrap.style.display='none';
          return;
        }
        if(rows.length===0){
          showUploadError('This CSV has headers but no data rows.');
          progWrap.style.display='none';
          return;
        }

        setTimeout(()=>{
          progFill.style.width='95%';
          bootstrapDataset(fields, rows, parsedDelimiter);
          progFill.style.width='100%';
          progLabel.textContent='Done';
          setTimeout(()=>{ progWrap.style.display='none'; }, 350);
        }, 50);
      }catch(err){
        console.error('CSV analysis error:', err);
        showUploadError('Something went wrong while analyzing this file: ' + (err && err.message ? err.message : String(err)));
        progWrap.style.display='none';
      }
    },
    error: function(err){
      console.error('CSV parse error:', err);
      showUploadError('Failed to read file: ' + (err && err.message ? err.message : String(err)));
      progWrap.style.display='none';
    }
  });
}

function inferColumns(fields, rows){
  const n = rows.length;
  return fields.map(name=>{
    const rawVals = rows.map(r => r[name]);
    const nonEmpty = rawVals.filter(v => v!==undefined && v!==null && String(v).trim()!=='');
    const missing = n - nonEmpty.length;
    const trimmed = nonEmpty.map(v=>String(v).trim());
    const uniqueSet = new Set(trimmed);

    let numericCount=0, boolCount=0, dateCount=0;
    trimmed.forEach(v=>{
      if(isNumericStr(v)) numericCount++;
      if(isBoolStr(v)) boolCount++;
      if(isDateStr(v)) dateCount++;
    });
    const total = trimmed.length || 1;
    let type = 'text';
    if(boolCount/total > 0.9 && uniqueSet.size<=3) type='boolean';
    else if(numericCount/total > 0.9) type='numeric';
    else if(dateCount/total > 0.85) type='date';
    else if(uniqueSet.size <= Math.max(20, total*0.5) && uniqueSet.size < total) type='categorical';
    else type='text';

    const looksId = (uniqueSet.size === trimmed.length && trimmed.length>1 &&
       (/^id$/i.test(name) || /_id$/i.test(name) || /^id_/i.test(name) || (type==='numeric' && isSequentialLike(trimmed))));

    const leadTrailSpace = nonEmpty.some(v => String(v) !== String(v).trim());
    const inconsistentCase = type==='categorical' && (()=>{
      const norm = new Set(trimmed.map(v=>v.toLowerCase().trim()));
      return norm.size < uniqueSet.size;
    })();

    return {
      name, type, missing, missingPct: (missing/n*100),
      unique: uniqueSet.size, total: n,
      looksId, leadTrailSpace, inconsistentCase,
      constant: uniqueSet.size<=1,
      empty: nonEmpty.length===0,
    };
  });
}
function isNumericStr(v){ if(v==='' || v===null || v===undefined) return false; const s=String(v).trim().replace(/,/g,''); if(s==='') return false; return !isNaN(s) && !isNaN(parseFloat(s)); }
function isBoolStr(v){ const s=String(v).trim().toLowerCase(); return ['true','false','yes','no','y','n','0','1'].includes(s); }
function isDateStr(v){
  const s = String(v).trim();
  if(s.length<6) return false;
  if(isNumericStr(s) && s.length<8) return false; // avoid plain ints
  const d = Date.parse(s);
  return !isNaN(d) && /[-\/]/.test(s);
}
function isSequentialLike(strs){
  const nums = strs.slice(0,Math.min(50,strs.length)).map(Number);
  if(nums.some(isNaN)) return false;
  let seq=0;
  for(let i=1;i<nums.length;i++){ if(nums[i]-nums[i-1]===1) seq++; }
  return seq >= nums.length*0.7;
}
function parseBool(v){ const s=String(v).trim().toLowerCase(); return ['true','yes','y','1'].includes(s); }
function parseNum(v){ return parseFloat(String(v).trim().replace(/,/g,'')); }

function typeRows(rawRows, columns){
  return rawRows.map(r=>{
    const o = {};
    columns.forEach(c=>{
      let v = r[c.name];
      if(v===undefined || v===null || String(v).trim()===''){ o[c.name]=null; return; }
      const s = String(v).trim();
      if(c.type==='numeric') o[c.name] = isNumericStr(s) ? parseNum(s) : null;
      else if(c.type==='boolean') o[c.name] = isBoolStr(s) ? parseBool(s) : null;
      else if(c.type==='date') { const t = Date.parse(s); o[c.name] = isNaN(t) ? null : t; }
      else o[c.name] = s;
    });
    return o;
  });
}

function bootstrapDataset(fields, rawRows, delimiter){
  const columns = inferColumns(fields, rawRows);
  STATE.columns = columns;
  STATE.originalRows = typeRows(rawRows, columns);
  STATE.cleanedRows = null;
  STATE.cleaningApplied = false;
  STATE.rawRowCount = rawRows.length;

  document.getElementById('topFileName').textContent = STATE.fileName;
  const meta = document.getElementById('topFileMeta');
  meta.style.display='inline-flex';
  meta.textContent = `${rawRows.length.toLocaleString()} rows · ${columns.length} cols · ${fmtBytes(STATE.fileSize)}`;
  document.getElementById('quickDownloadBtn').disabled = false;

  document.getElementById('dashUploadWrap').style.display='none';
  document.getElementById('dashLoaded').style.display='block';

  computeCleaningPlan();
  computeOutliers();
  generateInsights();

  renderDashboard();
  renderDatasetPanel();
  renderCleaningPanel();
  renderStatsPanel();
  renderOutliersPanel();
  renderInsightsPanel();
  renderMlPanel();
  renderTablePanel();
  renderReportsPanel();
  renderDownloadsPanel();

  toast(`Loaded ${STATE.fileName} — ${rawRows.length.toLocaleString()} rows, ${columns.length} columns.`);
}

function dataQualityScore(){
  const rows = activeRows();
  const n = rows.length;
  if(!n) return 0;
  let totalCells = n*STATE.columns.length;
  let missingCells = 0;
  STATE.columns.forEach(c=>{ rows.forEach(r=>{ if(r[c.name]===null||r[c.name]===undefined) missingCells++; }); });
  const dupCount = countDuplicates(rows);
  const constantCols = STATE.columns.filter(c=>c.constant).length;
  let score = 100;
  score -= (missingCells/totalCells)*35;
  score -= (dupCount/n)*25;
  score -= (constantCols/STATE.columns.length)*10;
  const idOk = 1;
  score = Math.max(0, Math.min(100, score));
  return Math.round(score);
}
function countDuplicates(rows){
  const seen = new Set(); let dup=0;
  rows.forEach(r=>{ const key = JSON.stringify(r); if(seen.has(key)) dup++; else seen.add(key); });
  return dup;
}

function renderDashboard(){
  const rows = activeRows();
  const n = rows.length;
  const totalMissing = STATE.columns.reduce((s,c)=>s + rows.filter(r=>r[c.name]===null).length, 0);
  const dupCount = countDuplicates(rows);
  const qScore = dataQualityScore();

  const cards = [
    ['Total Rows', n.toLocaleString(), ''],
    ['Total Columns', STATE.columns.length, ''],
    ['Numeric Columns', numericCols().length, ''],
    ['Categorical Columns', categoricalCols().length, ''],
    ['Missing Values', totalMissing.toLocaleString(), fmtPct(totalMissing/(n*STATE.columns.length)*100)+' of cells'],
    ['Duplicate Rows', dupCount.toLocaleString(), n?fmtPct(dupCount/n*100):''],
    ['Data Quality Score', qScore+' / 100', qScore>=80?'Good':qScore>=55?'Fair':'Needs cleaning'],
    ['Dataset Size', fmtBytes(STATE.fileSize), STATE.fileName],
  ];
  document.getElementById('overviewCards').innerHTML = cards.map(([l,v,s])=>`
    <div class="card stat-card"><div class="stat-label">${l}</div><div class="stat-value">${v}</div><div class="stat-sub">${s}</div></div>
  `).join('');

  document.getElementById('colProfileHint').textContent = `${STATE.columns.length} columns detected`;
  document.getElementById('columnProfileTable').innerHTML = buildColumnProfileTable(rows, true);

  document.getElementById('dashInsights').innerHTML = STATE.insights.slice(0,4).map(insightHtml).join('') || emptyInsightHtml();
}

function buildColumnProfileTable(rows, compact){
  const n = rows.length;
  let head = `<tr><th>Column</th><th>Type</th><th>Unique</th><th>Missing</th><th>Missing %</th>`;
  if(!compact) head += `<th>Min</th><th>Max</th><th>Mean</th><th>Median</th>`;
  head += `<th>Flags</th></tr>`;
  const body = STATE.columns.map(c=>{
    const vals = rows.map(r=>r[c.name]).filter(v=>v!==null && v!==undefined);
    let min='—',max='—',mean='—',median='—';
    if(c.type==='numeric' && vals.length){
      min = fmtNum(S.min(vals)); max = fmtNum(S.max(vals)); mean = fmtNum(S.mean(vals)); median = fmtNum(S.median(vals));
    } else if(c.type==='date' && vals.length){
      min = new Date(S.min(vals)).toLocaleDateString(); max = new Date(S.max(vals)).toLocaleDateString();
    }
    const flags = [];
    if(c.looksId) flags.push('<span class="badge id">ID</span>');
    if(c.constant) flags.push('<span class="badge warn">constant</span>');
    if(c.leadTrailSpace) flags.push('<span class="badge warn">spacing</span>');
    if(c.inconsistentCase) flags.push('<span class="badge warn">case</span>');
    if(c.missingPct>30) flags.push('<span class="badge warn">high-missing</span>');
    const typeBadge = `<span class="badge ${c.type}">${c.type}</span>`;
    let row = `<tr><td><strong>${escapeHtml(c.name)}</strong></td><td>${typeBadge}</td><td>${c.unique.toLocaleString()}</td><td>${c.missing.toLocaleString()}</td><td>${fmtPct(c.missingPct)}</td>`;
    if(!compact) row += `<td>${min}</td><td>${max}</td><td>${mean}</td><td>${median}</td>`;
    row += `<td>${flags.join(' ')||'—'}</td></tr>`;
    return row;
  }).join('');
  return head + body;
}

function insightHtml(ins){
  return `<div class="insight-card"><div class="insight-icon ${ins.tone}">${ins.icon}</div>
    <div><div class="insight-text">${ins.text}</div>${ins.metric?`<div class="insight-metric">${ins.metric}</div>`:''}</div></div>`;
}
function emptyInsightHtml(){ return `<div class="empty-state" style="padding:30px;"><p>No insights yet.</p></div>`; }

function buildFullDatasetTable(rows, showAll){
  const displayRows = showAll ? rows : rows.slice(0, Math.min(50, rows.length));
  let html = `<div class="dataset-table-wrap"><div class="table-scroll"><table class="dl-table full-data-table"><thead><tr><th>#</th>${STATE.columns.map(c=>`<th>${escapeHtml(c.name)}</th>`).join('')}</tr></thead><tbody>`;
  html += displayRows.map((r,idx)=>`<tr><td class="row-number">${idx+1}</td>${STATE.columns.map(c=>`<td>${r[c.name]===null||r[c.name]===undefined?'—':escapeHtml(String(r[c.name]))}</td>`).join('')}</tr>`).join('');
  html += `</tbody></table></div></div>`;
  return html;
}

function renderDatasetPanel(){
  const rows=activeRows(), idCols=STATE.columns.filter(c=>c.looksId).map(c=>c.name), targetGuess=guessTargetColumn();
  const initialCount=Math.min(50,rows.length);
  const html=`<div class="grid cols-4" style="margin-bottom:22px;">
    <div class="card stat-card"><div class="stat-label">Rows</div><div class="stat-value">${rows.length.toLocaleString()}</div></div>
    <div class="card stat-card"><div class="stat-label">Columns</div><div class="stat-value">${STATE.columns.length}</div></div>
    <div class="card stat-card"><div class="stat-label">Duplicate rows</div><div class="stat-value">${countDuplicates(rows).toLocaleString()}</div></div>
    <div class="card stat-card"><div class="stat-label">File size</div><div class="stat-value" style="font-size:20px;">${fmtBytes(STATE.fileSize)}</div></div>
  </div>
  <div class="section-title"><h2>Type breakdown</h2></div><div class="tag-row" style="margin-bottom:22px;">
    ${['numeric','categorical','boolean','date','text'].map(t=>{const c=STATE.columns.filter(col=>col.type===t).length;return c?`<span class="badge ${t}">${t}: ${c}</span>`:''}).join('')}
  </div>
  <div class="section-title"><h2>Likely important columns</h2><span class="hint">Inferred from data characteristics, not column names alone</span></div>
  <div class="tag-row" style="margin-bottom:22px;">${idCols.length?idCols.map(n=>`<span class="badge id">ID: ${escapeHtml(n)}</span>`).join(''):'<span class="badge">No obvious ID column</span>'}${dateCols().map(n=>`<span class="badge date">Date: ${escapeHtml(n)}</span>`).join('')}${targetGuess?`<span class="badge num">Likely target: ${escapeHtml(targetGuess)}</span>`:''}</div>
  <div class="section-title"><h2>All dataset rows & columns</h2><span class="hint">${rows.length>initialCount?'Showing '+initialCount.toLocaleString()+' of '+rows.length.toLocaleString()+' rows':'Showing all '+rows.length.toLocaleString()+' rows'}</span></div>
  <div class="card" style="margin-bottom:22px;"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;"><div><strong>${rows.length.toLocaleString()} rows × ${STATE.columns.length} columns</strong><div class="hint">Scroll horizontally to see every column.</div></div><button class="btn primary" id="datasetShowAllBtn">${rows.length>initialCount?'Show All':'Show Less'}</button></div><div id="fullDatasetTableBody">${buildFullDatasetTable(rows,rows.length<=initialCount)}</div></div>
  <div class="section-title"><h2>Full column profile</h2></div><div class="table-scroll"><table class="dl-table">${buildColumnProfileTable(rows,false)}</table></div>`;
  document.getElementById('datasetPanelBody').innerHTML=html;
  const btn=document.getElementById('datasetShowAllBtn'); let showingAll=rows.length<=initialCount;
  if(btn) btn.addEventListener('click',()=>{showingAll=!showingAll;document.getElementById('fullDatasetTableBody').innerHTML=buildFullDatasetTable(rows,showingAll);btn.textContent=showingAll?'Show Less':'Show All';});
}

function guessTargetColumn(){
  const candidates = STATE.columns.filter(c=>!c.looksId && (c.type==='numeric'||c.type==='categorical'||c.type==='boolean'));
  const scored = candidates.map(c=>{
    let score=0;
    if(/price|revenue|amount|sales|target|score|value|cost|profit|churn|label|outcome|status|class/i.test(c.name)) score+=5;
    if(c.type==='numeric') score+=1;
    return {c,score};
  }).sort((a,b)=>b.score-a.score);
  return scored.length? scored[0].c.name : null;
}

function computeCleaningPlan(){
  const rows = STATE.originalRows;
  const n = rows.length;
  const actions = [];

  const dupCount = countDuplicates(rows);
  if(dupCount>0) actions.push({id:'dupes', title:`Remove ${dupCount} duplicate row${dupCount===1?'':'s'}`,
    desc:'Exact duplicate rows will be dropped, keeping the first occurrence.', defaultOn:true});

  STATE.columns.forEach(c=>{
    if(c.empty){
      actions.push({id:'empty_'+c.name, col:c.name, title:`Remove empty column "${c.name}"`, desc:'Every value in this column is missing.', defaultOn:true});
    } else if(c.constant){
      actions.push({id:'const_'+c.name, col:c.name, title:`Remove constant column "${c.name}"`, desc:'This column has a single repeated value and carries no information.', defaultOn:false});
    } else if(c.missing>0 && c.type==='numeric'){
      actions.push({id:'fillnum_'+c.name, col:c.name, title:`Fill ${c.missing} missing value${c.missing===1?'':'s'} in "${c.name}" with the median`, desc:`${fmtPct(c.missingPct)} missing.`, defaultOn:true});
    } else if(c.missing>0 && (c.type==='categorical'||c.type==='boolean'||c.type==='text')){
      actions.push({id:'fillcat_'+c.name, col:c.name, title:`Fill ${c.missing} missing value${c.missing===1?'':'s'} in "${c.name}" with the mode (most frequent value)`, desc:`${fmtPct(c.missingPct)} missing.`, defaultOn:true});
    } else if(c.missing>0 && c.type==='date'){
      actions.push({id:'fillnothing_'+c.name, col:c.name, title:`Leave ${c.missing} missing date(s) in "${c.name}" untouched`, desc:'Dates are not imputed automatically.', defaultOn:false});
    }
    if(c.leadTrailSpace) actions.push({id:'trim_'+c.name, col:c.name, title:`Trim leading/trailing spaces in "${c.name}"`, desc:'Whitespace around text values will be removed.', defaultOn:true});
    if(c.inconsistentCase) actions.push({id:'case_'+c.name, col:c.name, title:`Normalize casing in "${c.name}"`, desc:'Values differing only by capitalization will be unified to Title Case.', defaultOn:false});
  });

  STATE.cleaningPlan = actions;
}

function applyCleaning(selectedIds){
  const rows = STATE.originalRows.map(r=>({...r}));
  let working = rows;
  const summary = { rowsBefore: rows.length, duplicatesRemoved:0, missingHandled:0, columnsConverted:0, columnsRemoved:[], invalidHandled:0 };

  if(selectedIds.has('dupes')){
    const seen = new Set(); const out=[];
    working.forEach(r=>{ const key=JSON.stringify(r); if(seen.has(key)){ summary.duplicatesRemoved++; } else { seen.add(key); out.push(r); } });
    working = out;
  }

  const removeCols = new Set();
  STATE.cleaningPlan.forEach(a=>{
    if(!selectedIds.has(a.id)) return;
    if(a.id.startsWith('empty_')||a.id.startsWith('const_')){ removeCols.add(a.col); summary.columnsRemoved.push(a.col); }
  });
  if(removeCols.size){ working = working.map(r=>{ const o={...r}; removeCols.forEach(c=>delete o[c]); return o; }); }

  STATE.cleaningPlan.forEach(a=>{
    if(!selectedIds.has(a.id) || removeCols.has(a.col)) return;
    if(a.id.startsWith('fillnum_')){
      const vals = working.map(r=>r[a.col]).filter(v=>v!==null);
      const med = S.median(vals);
      working.forEach(r=>{ if(r[a.col]===null){ r[a.col]=med; summary.missingHandled++; } });
    } else if(a.id.startsWith('fillcat_')){
      const vals = working.map(r=>r[a.col]).filter(v=>v!==null);
      const mode = S.mode(vals);
      working.forEach(r=>{ if(r[a.col]===null){ r[a.col]=mode; summary.missingHandled++; } });
    } else if(a.id.startsWith('trim_')){
      working.forEach(r=>{ if(typeof r[a.col]==='string'){ const t=r[a.col].trim(); if(t!==r[a.col]){ r[a.col]=t; summary.invalidHandled++; } } });
      summary.columnsConverted++;
    } else if(a.id.startsWith('case_')){
      working.forEach(r=>{ if(typeof r[a.col]==='string'){ r[a.col] = r[a.col].replace(/\\w\\S*/g, t=>t[0].toUpperCase()+t.slice(1).toLowerCase()); } });
      summary.columnsConverted++;
    }
  });

  summary.rowsAfter = working.length;
  STATE.cleanedRows = working;
  STATE.cleaningApplied = true;
  STATE.cleaningSummary = summary;

  if(removeCols.size){
    STATE.columns = STATE.columns.filter(c=>!removeCols.has(c.name));
  }
  recomputeAllDerived();
  toast('Cleaning applied. Analysis views now use the cleaned dataset.');
}

function recomputeAllDerived(){
  computeOutliers(); generateInsights();
  renderDashboard(); renderDatasetPanel(); renderStatsPanel(); renderOutliersPanel(); renderInsightsPanel(); renderMlPanel();
  renderTablePanel(); renderReportsPanel(); renderDownloadsPanel();
}

function renderCleaningPanel(){
  const plan = STATE.cleaningPlan;
  const body = document.getElementById('cleaningPanelBody');
  if(plan.length===0){
    body.innerHTML = `<div class="card"><h3>✓ No issues detected</h3><p style="color:var(--ink-soft); margin-top:8px; font-size:13px;">This dataset looks clean already — no duplicates, empty columns, or missing values found.</p></div>`;
    return;
  }
  body.innerHTML = `
    <div class="card" style="margin-bottom:18px;">
      <h3 style="margin-bottom:4px;">Suggested actions (${plan.length})</h3>
      <p style="font-size:12.5px; color:var(--ink-faint); margin-bottom:10px;">Untick anything you don't want. The original dataset is preserved regardless.</p>
      <div id="cleaningChecklist"></div>
      <div style="display:flex; gap:10px; margin-top:16px;">
        <button class="btn primary" id="applyCleaningBtn">Apply selected cleaning</button>
        <button class="btn ghost" id="revertCleaningBtn" ${STATE.cleaningApplied?'':'disabled'}>Revert to original</button>
      </div>
    </div>
    <div id="cleaningSummaryWrap"></div>
  `;
  const list = document.getElementById('cleaningChecklist');
  list.innerHTML = plan.map(a=>`
    <label class="check-row">
      <input type="checkbox" data-action-id="${a.id}" ${a.defaultOn?'checked':''}>
      <div><div class="ct-title">${escapeHtml(a.title)}</div><div class="ct-desc">${escapeHtml(a.desc)}</div></div>
    </label>
  `).join('');

  document.getElementById('applyCleaningBtn').addEventListener('click', ()=>{
    const checked = new Set([...list.querySelectorAll('input[type=checkbox]:checked')].map(el=>el.dataset.actionId));
    applyCleaning(checked);
    renderCleaningPanel();
  });
  document.getElementById('revertCleaningBtn').addEventListener('click', ()=>{
    STATE.cleaningApplied = false; STATE.cleanedRows=null; STATE.cleaningSummary=null;
    recomputeAllDerived(); renderCleaningPanel();
    toast('Reverted to original dataset.');
  });

  if(STATE.cleaningSummary){
    const s = STATE.cleaningSummary;
    document.getElementById('cleaningSummaryWrap').innerHTML = `
      <div class="section-title"><h2>Cleaning summary</h2></div>
      <div class="grid cols-4">
        <div class="card stat-card"><div class="stat-label">Rows before</div><div class="stat-value">${s.rowsBefore.toLocaleString()}</div></div>
        <div class="card stat-card"><div class="stat-label">Rows after</div><div class="stat-value">${s.rowsAfter.toLocaleString()}</div></div>
        <div class="card stat-card"><div class="stat-label">Duplicates removed</div><div class="stat-value">${s.duplicatesRemoved}</div></div>
        <div class="card stat-card"><div class="stat-label">Missing values handled</div><div class="stat-value">${s.missingHandled}</div></div>
        <div class="card stat-card"><div class="stat-label">Columns removed</div><div class="stat-value" style="font-size:16px;">${s.columnsRemoved.length? s.columnsRemoved.join(', ') : 'None'}</div></div>
        <div class="card stat-card"><div class="stat-label">Columns transformed</div><div class="stat-value">${s.columnsConverted}</div></div>
        <div class="card stat-card"><div class="stat-label">Values normalized</div><div class="stat-value">${s.invalidHandled}</div></div>
      </div>`;
  }
}

function renderStatsPanel(){
  const rows = activeRows();
  const body = document.getElementById('statsPanelBody');
  const nums = numericCols(), cats = categoricalCols();
  let html = `<div class="section-title"><h2>Numerical columns</h2></div>`;
  if(!nums.length){
    html += `<p style="color:var(--ink-faint); font-size:13px;">No numeric columns detected.</p>`;
  } else {
    html += `<div class="table-scroll"><table class="dl-table"><tr><th>Column</th><th>Count</th><th>Mean</th><th>Median</th><th>Mode</th><th>Min</th><th>Max</th><th>Range</th><th>Std Dev</th><th>Variance</th><th>Q1</th><th>Q3</th><th>IQR</th></tr>`;
    nums.forEach(name=>{
      const vals = rows.map(r=>r[name]).filter(v=>v!==null && v!==undefined);
      const s = vals.slice().sort((a,b)=>a-b);
      const q1=S.percentile(s,25), q3=S.percentile(s,75);
      html += `<tr><td><strong>${escapeHtml(name)}</strong></td><td>${vals.length}</td><td>${fmtNum(S.mean(vals))}</td><td>${fmtNum(S.median(vals))}</td>
        <td>${fmtNum(S.mode(vals))}</td><td>${fmtNum(S.min(vals))}</td><td>${fmtNum(S.max(vals))}</td><td>${fmtNum(S.max(vals)-S.min(vals))}</td>
        <td>${fmtNum(S.std(vals))}</td><td>${fmtNum(S.variance(vals))}</td><td>${fmtNum(q1)}</td><td>${fmtNum(q3)}</td><td>${fmtNum(q3-q1)}</td></tr>`;
    });
    html += `</table></div>`;
  }

  html += `<div class="section-title"><h2>Categorical columns</h2></div>`;
  if(!cats.length){
    html += `<p style="color:var(--ink-faint); font-size:13px;">No categorical columns detected.</p>`;
  } else {
    html += `<div class="table-scroll"><table class="dl-table"><tr><th>Column</th><th>Unique values</th><th>Most common</th><th>Frequency</th><th>Percentage</th></tr>`;
    cats.forEach(name=>{
      const vals = rows.map(r=>r[name]).filter(v=>v!==null && v!==undefined);
      const freq = new Map(); vals.forEach(v=>freq.set(v,(freq.get(v)||0)+1));
      let top=null, topC=0; freq.forEach((c,v)=>{ if(c>topC){topC=c; top=v;} });
      html += `<tr><td><strong>${escapeHtml(name)}</strong></td><td>${freq.size}</td><td>${escapeHtml(String(top))}</td><td>${topC}</td><td>${fmtPct(vals.length?topC/vals.length*100:0)}</td></tr>`;
    });
    html += `</table></div>`;
  }

  html += `<div class="section-title"><h2>Column deep dive</h2></div>
    <div class="card">
      <div class="field"><label class="field-label">Select a column</label>
        <select class="pill-select" id="deepDiveSelect">${STATE.columns.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)} (${c.type})</option>`).join('')}</select>
      </div>
      <div id="deepDiveOut"></div>
    </div>`;

  body.innerHTML = html;
  document.getElementById('deepDiveSelect').addEventListener('change', renderDeepDive);
  renderDeepDive();
}

function renderDeepDive(){
  const name = document.getElementById('deepDiveSelect').value;
  const c = colMeta(name);
  const rows = activeRows();
  const vals = rows.map(r=>r[name]).filter(v=>v!==null && v!==undefined);
  let html = `<div class="grid cols-4" style="margin-top:14px;">
    <div class="card stat-card"><div class="stat-label">Type</div><div class="stat-value" style="font-size:18px;">${c.type}</div></div>
    <div class="card stat-card"><div class="stat-label">Unique</div><div class="stat-value">${c.unique}</div></div>
    <div class="card stat-card"><div class="stat-label">Missing</div><div class="stat-value">${c.missing} <span style="font-size:12px; color:var(--ink-faint);">(${fmtPct(c.missingPct)})</span></div></div>`;
  if(c.type==='numeric'){
    const s = vals.slice().sort((a,b)=>a-b);
    html += `<div class="card stat-card"><div class="stat-label">Percentiles</div><div class="stat-sub mono">p10 ${fmtNum(S.percentile(s,10))} · p90 ${fmtNum(S.percentile(s,90))} · p99 ${fmtNum(S.percentile(s,99))}</div></div></div>`;
  } else {
    html += `</div>`;
  }
  document.getElementById('deepDiveOut').innerHTML = html;
}

function corrColor(v){
  if(Number.isNaN(v)) return 'transparent';
  const dark = document.documentElement.getAttribute('data-theme')==='dark';
  const a = Math.min(1, Math.abs(v));
  if(v>=0) return `rgba(47,111,107,${0.12+a*0.75})`;
  return `rgba(178,76,59,${0.12+a*0.75})`;
}

function computeOutliers(){
  const rows = activeRows(); const nums = numericCols();
  const report = {};
  nums.forEach(name=>{
    const idxVals = [];
    rows.forEach((r,i)=>{ if(r[name]!==null) idxVals.push([i, r[name]]); });
    const vals = idxVals.map(p=>p[1]);
    if(vals.length<4){ report[name] = {count:0, pct:0, lower:NaN, upper:NaN, rows:[]}; return; }
    const s = vals.slice().sort((a,b)=>a-b);
    const q1=S.percentile(s,25), q3=S.percentile(s,75), iqr=q3-q1;
    const lower=q1-1.5*iqr, upper=q3+1.5*iqr;
    const mean=S.mean(vals), std=S.std(vals);
    const flagged = idxVals.filter(([i,v])=> v<lower || v>upper).map(([i,v])=>({rowIndex:i, value:v, zscore: std? (v-mean)/std : 0}));
    report[name] = { count: flagged.length, pct: flagged.length/vals.length*100, lower, upper, rows: flagged };
  });
  STATE.outlierReport = report;
}
function renderOutliersPanel(){
  const body = document.getElementById('outliersPanelBody');
  const nums = numericCols();
  if(!nums.length){ body.innerHTML = `<div class="empty-state"><h3>No numeric columns</h3></div>`; return; }
  const rep = STATE.outlierReport;
  let cardsHtml = `<div class="table-scroll" style="margin-bottom:20px;"><table class="dl-table"><tr><th>Column</th><th>Outliers</th><th>% of data</th><th>Lower fence</th><th>Upper fence</th></tr>`;
  nums.forEach(n=>{
    const r = rep[n];
    cardsHtml += `<tr><td><strong>${escapeHtml(n)}</strong></td><td>${r.count}</td><td>${fmtPct(r.pct)}</td><td>${fmtNum(r.lower)}</td><td>${fmtNum(r.upper)}</td></tr>`;
  });
  cardsHtml += `</table></div>`;

  body.innerHTML = `
    <div class="card" style="margin-bottom:8px; background: rgba(192,138,46,0.08); border-color:var(--warn);">
      <strong style="color:var(--warn);">Note:</strong> <span style="font-size:13px;">An outlier may be a valid, important observation — not an error. Review before deciding to keep, remove, or investigate further. DataLens never removes rows automatically.</span>
    </div>
    ${cardsHtml}
    <div class="section-title"><h2>Inspect a column</h2></div>
    <div class="card">
      <div class="field"><label class="field-label">Column</label>
        <select class="pill-select" id="outlierColSelect">${nums.map(n=>`<option>${escapeHtml(n)}</option>`).join('')}</select>
      </div>
      <div class="table-scroll" style="margin-top:14px; max-height:280px;"><table class="dl-table" id="outlierRowsTable"></table></div>
    </div>
  `;
  const update = ()=>{
    const name = document.getElementById('outlierColSelect').value;
    const rows = activeRows();
    const vals = rows.map(r=>r[name]).filter(v=>v!==null);
    const r = rep[name];
    const otherCols = STATE.columns.filter(c=>c.name!==name).slice(0,3).map(c=>c.name);
    let t = `<tr><th>Row #</th><th>${escapeHtml(name)}</th>${otherCols.map(c=>`<th>${escapeHtml(c)}</th>`).join('')}<th>Z-score</th></tr>`;
    r.rows.slice(0,100).forEach(row=>{
      const full = rows[row.rowIndex];
      t += `<tr><td>${row.rowIndex+1}</td><td class="outlier-cell">${fmtNum(row.value)}</td>${otherCols.map(c=>`<td>${full[c]===null?'—':escapeHtml(String(full[c]))}</td>`).join('')}<td>${fmtNum(row.zscore)}</td></tr>`;
    });
    if(!r.rows.length) t += `<tr><td colspan="10" style="color:var(--ink-faint);">No outliers detected in this column.</td></tr>`;
    document.getElementById('outlierRowsTable').innerHTML = t;
  };
  document.getElementById('outlierColSelect').addEventListener('change', update);
  update();
}

function generateInsights(){
  const rows = activeRows();
  const n = rows.length;
  const insights = [];
  const nums = numericCols(), cats = categoricalCols();

  STATE.columns.forEach(c=>{
    if(c.missingPct>15 && c.missingPct<100){
      insights.push({tone:'warn', icon:'!', text:`Column "${escapeHtml(c.name)}" contains approximately ${fmtPct(c.missingPct)} missing values and may need cleaning before analysis.`, metric:`${c.missing} of ${c.total} rows missing`});
    }
  });

  const dup = countDuplicates(rows);
  if(dup>0) insights.push({tone:'warn', icon:'⧉', text:`${dup} duplicate row${dup===1?'':'s'} detected (${fmtPct(dup/n*100)} of the dataset).`, metric:`${dup} / ${n} rows`});

  STATE.columns.filter(c=>c.constant).forEach(c=>{
    insights.push({tone:'info', icon:'≡', text:`Column "${escapeHtml(c.name)}" has the same value in every row and carries no analytical signal.`});
  });

  nums.forEach(name=>{
    const vals = rows.map(r=>r[name]).filter(v=>v!==null);
    if(vals.length<3) return;
    const mean=S.mean(vals), median=S.median(vals), std=S.std(vals);
    const skew = std? (mean-median)/std : 0;
    if(Math.abs(skew) > 0.4){
      insights.push({tone:'info', icon:'⤴', text:`"${escapeHtml(name)}" appears ${skew>0?'right':'left'}-skewed — the mean (${fmtNum(mean)}) differs noticeably from the median (${fmtNum(median)}).`, metric:`mean ${fmtNum(mean)} vs median ${fmtNum(median)}`});
    }
    const rep = STATE.outlierReport && STATE.outlierReport[name];
    if(rep && rep.pct>5){
      insights.push({tone:'warn', icon:'◆', text:`"${escapeHtml(name)}" has ${fmtPct(rep.pct)} of values flagged as statistical outliers (IQR method).`, metric:`${rep.count} rows outside [${fmtNum(rep.lower)}, ${fmtNum(rep.upper)}]`});
    }
  });

  cats.forEach(name=>{
    const vals = rows.map(r=>r[name]).filter(v=>v!==null);
    if(!vals.length) return;
    const freq = new Map(); vals.forEach(v=>freq.set(v,(freq.get(v)||0)+1));
    const entries = [...freq.entries()].sort((a,b)=>b[1]-a[1]);
    const top3 = entries.slice(0,3).reduce((s,e)=>s+e[1],0);
    if(entries.length>3 && top3/vals.length > 0.6){
      insights.push({tone:'good', icon:'●', text:`"${escapeHtml(name)}" is concentrated in a few categories — the top ${Math.min(3,entries.length)} values (${entries.slice(0,3).map(e=>e[0]).join(', ')}) account for ${fmtPct(top3/vals.length*100)} of records.`, metric:`${top3} / ${vals.length} rows`});
    }
    if(entries.length===1) insights.push({tone:'info', icon:'≡', text:`"${escapeHtml(name)}" has only one distinct value across the dataset.`});
  });

  nums.slice(0,4).forEach(name=>{
    const vals = rows.map((r,i)=>[i,r[name]]).filter(p=>p[1]!==null);
    if(!vals.length) return;
    const maxP = vals.reduce((a,b)=>b[1]>a[1]?b:a);
    const minP = vals.reduce((a,b)=>b[1]<a[1]?b:a);
    insights.push({tone:'info', icon:'▲', text:`The highest value of "${escapeHtml(name)}" is ${fmtNum(maxP[1])} (row ${maxP[0]+1}); the lowest is ${fmtNum(minP[1])} (row ${minP[0]+1}).`});
  });

  if(!insights.length) insights.push({tone:'good', icon:'✓', text:'No major data-quality issues or strong patterns were detected — this dataset looks clean and fairly uniform.'});

  STATE.insights = insights;
}

function renderInsightsPanel(){
  const body = document.getElementById('insightsPanelBody');
  body.innerHTML = `
    <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
      <button class="btn" id="regenInsightsBtn">↻ Regenerate</button>
      <button class="btn accent" id="aiWriteBtn">✨ Write with AI (optional)</button>
      <span id="aiInsightStatus" style="font-size:12px; color:var(--ink-faint); align-self:center;"></span>
    </div>
    <div id="insightsList"></div>
  `;
  document.getElementById('insightsList').innerHTML = STATE.insights.map(insightHtml).join('');
  document.getElementById('regenInsightsBtn').addEventListener('click', ()=>{
    generateInsights(); document.getElementById('insightsList').innerHTML = STATE.insights.map(insightHtml).join('');
    renderDashboard();
    toast('Insights regenerated.');
  });
  document.getElementById('aiWriteBtn').addEventListener('click', tryAiInsights);
}

async function tryAiInsights(){
  const statusEl = document.getElementById('aiInsightStatus');
  statusEl.textContent = 'Contacting model…';
  const summary = {
    fileName: STATE.fileName, rows: activeRows().length, columns: STATE.columns.length,
    columnTypes: STATE.columns.map(c=>({name:c.name, type:c.type, missingPct:Math.round(c.missingPct), unique:c.unique})),
    dataQualityScore: dataQualityScore(),
    duplicates: countDuplicates(activeRows()),
    outlierColumns: STATE.outlierReport ? Object.entries(STATE.outlierReport).filter(([k,v])=>v.count>0).map(([k,v])=>({col:k, pct:Number(v.pct.toFixed(1))})) : [],
  };
  try{
    const resp = await fetch("https://api.anthropic.com/v1/messages", {
      method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({
        model:"claude-sonnet-4-6", max_tokens:1000,
        messages:[{role:"user", content:
          "You are a data analyst. Based ONLY on this computed dataset summary JSON, write 5-8 short, specific, plain-language insight bullets (no markdown headers, one sentence each, no invented numbers beyond what's given):\\n\\n" + JSON.stringify(summary)
        }]
      })
    });
    if(!resp.ok) throw new Error('status '+resp.status);
    const data = await resp.json();
    const text = (data.content||[]).map(b=>b.text||'').join('\\n').trim();
    if(!text) throw new Error('empty response');
    const lines = text.split('\\n').map(l=>l.replace(/^[-•\\d.\\)]+\\s*/,'').trim()).filter(l=>l.length>8);
    const aiInsights = lines.map(l=>({tone:'info', icon:'✨', text: escapeHtml(l)}));
    STATE.insights = aiInsights.concat(STATE.insights);
    document.getElementById('insightsList').innerHTML = STATE.insights.map(insightHtml).join('');
    statusEl.textContent = 'AI-written insights added above.';
    renderDashboard();
  }catch(err){
    console.warn('AI insight generation unavailable, using rule-based insights only.', err);
    statusEl.textContent = 'AI writer unavailable right now — showing built-in insights only.';
  }
}

function renderMlPanel(){
  const body = document.getElementById('mlPanelBody');
  const candidates = STATE.columns.filter(c=>!c.looksId && !c.constant && (c.type==='numeric'||c.type==='categorical'||c.type==='boolean'));
  if(candidates.length<2 || activeRows().length<20){
    body.innerHTML = `<div class="empty-state"><h3>Prediction not recommended</h3><p>This dataset is too small or lacks suitable columns (need at least ~20 rows and 2+ usable columns, excluding IDs) for a reliable baseline model.</p></div>`;
    return;
  }
  body.innerHTML = `
    <div class="card" style="margin-bottom:18px;">
      <div class="grid cols-2">
        <div class="field"><label class="field-label">Target column</label>
          <select class="pill-select" id="mlTarget">${candidates.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)} (${c.type})</option>`).join('')}</select>
        </div>
        <div class="field"><label class="field-label">Task</label>
          <div id="mlTaskLabel" class="stat-sub" style="margin-top:9px;"></div>
        </div>
        <div class="field"><label class="field-label">Algorithm</label>
          <select class="pill-select" id="mlAlgorithm"></select>
        </div>
        <div class="field"><label class="field-label">Train / Test Split</label>
          <select class="pill-select" id="mlSplit"><option value="0.8">80% / 20%</option><option value="0.7">70% / 30%</option><option value="0.75">75% / 25%</option></select>
        </div>
      </div>
      <div class="field"><label class="field-label">Feature columns</label>
        <div class="tag-row" id="mlFeatures"></div>
      </div>
      <button class="btn primary" id="mlRunBtn">Train baseline model</button>
    </div>
    <div id="mlResultWrap"></div>
  `;
  const targetSel = document.getElementById('mlTarget');
  const featWrap = document.getElementById('mlFeatures');
  function refreshFeatures(){
    const target = targetSel.value;
    const tCol = colMeta(target);
    const task = tCol.type==='numeric' ? 'regression' : 'classification';
    document.getElementById('mlTaskLabel').textContent = task==='regression' ? 'Regression (predicting a number)' : 'Classification (predicting a category)';
    const algorithms = task==='regression'
      ? ['Linear Regression','Decision Tree Regressor','Random Forest Regressor','KNN Regressor']
      : ['Logistic Regression','Decision Tree Classifier','Random Forest Classifier','KNN Classifier','Naive Bayes','SVM'];
    document.getElementById('mlAlgorithm').innerHTML = algorithms.map(a=>`<option value="${a}">${a}</option>`).join('');
    featWrap.innerHTML = candidates.filter(c=>c.name!==target).map(c=>`
      <label style="display:flex; align-items:center; gap:5px; border:1px solid var(--line); border-radius:7px; padding:5px 9px; font-size:12px; cursor:pointer;">
        <input type="checkbox" value="${escapeHtml(c.name)}" checked style="margin:0;"> ${escapeHtml(c.name)}
      </label>`).join('');
  }
  targetSel.addEventListener('change', refreshFeatures);
  refreshFeatures();

  document.getElementById('mlRunBtn').addEventListener('click', ()=>{
    const target = targetSel.value;
    const features = [...featWrap.querySelectorAll('input:checked')].map(el=>el.value);
    if(!features.length){ toast('Select at least one feature column.', 'err'); return; }
    try{
      const algorithm = document.getElementById('mlAlgorithm').value;
      const split = parseFloat(document.getElementById('mlSplit').value)||0.8;
      const result = runSelectedModel(target, features, algorithm, split);
      STATE.mlResult = result;
      renderMlResult(result);
    }catch(e){
      console.error(e);
      document.getElementById('mlResultWrap').innerHTML = `<div class="card"><h3>Prediction not available</h3><p style="font-size:13px; color:var(--ink-soft);">${escapeHtml(e.message)}</p></div>`;
    }
  });
}

function oneHotEncode(rows, catCol){
  const values = [...new Set(rows.map(r=>r[catCol]).filter(v=>v!==null))];
  return values.map(v => ({ name: catCol+'='+v, fn: r => r[catCol]===v ? 1 : 0 }));
}

function buildFeatureMatrix(rows, features){
  const encoders = [];
  features.forEach(f=>{
    const c = colMeta(f);
    if(c.type==='numeric') encoders.push({name:f, fn:r=>r[f]});
    else if(c.type==='boolean') encoders.push({name:f, fn:r=>r[f]?1:0});
    else { const oh = oneHotEncode(rows, f); if(oh.length<=10) encoders.push(...oh); else encoders.push({name:f+'(freq)', fn:(()=>{ const freq=new Map(); rows.forEach(r=>freq.set(r[f],(freq.get(r[f])||0)+1)); return r=>freq.get(r[f])||0; })()}); }
  });
  return encoders;
}

function runSelectedModel(target, features, algorithm, split=0.8){
  if(algorithm==='Linear Regression' || algorithm==='Logistic Regression'){
    return legacyRunBaselineModel(target, features, split, algorithm);
  }
  if(algorithm==='K-Means') return runKMeansModel(features);
  const allRows=activeRows(); const tCol=colMeta(target); const encoders=buildFeatureMatrix(allRows,features);
  if(!encoders.length) throw new Error('No usable feature columns after encoding.');
  const clean=allRows.filter(r=>r[target]!==null && encoders.every(e=>{const v=e.fn(r); return v!==null && Number.isFinite(v);}));
  if(clean.length<20) throw new Error('Not enough complete rows (need 20+) after preprocessing.');
  const shuffled=[...clean]; for(let i=shuffled.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[shuffled[i],shuffled[j]]=[shuffled[j],shuffled[i]];}
  const splitIdx=Math.max(1,Math.floor(shuffled.length*split)); const train=shuffled.slice(0,splitIdx), test=shuffled.slice(splitIdx);
  const X=rows=>rows.map(r=>encoders.map(e=>e.fn(r))); const Xtr=X(train), Xte=X(test);
  const means=encoders.map((_,j)=>S.mean(Xtr.map(r=>r[j]))); const stds=encoders.map((_,j)=>S.std(Xtr.map(r=>r[j]))||1);
  const norm=M=>M.map(r=>r.map((v,j)=>(v-means[j])/stds[j])); const A=norm(Xtr), B=norm(Xte);
  if(tCol.type==='numeric') return runRegressionAlgorithm(algorithm,target,encoders,train,test,A,B);
  return runClassificationAlgorithm(algorithm,target,encoders,train,test,A,B);
}
function dist(a,b){return Math.sqrt(a.reduce((s,v,i)=>s+(v-b[i])**2,0));}
function knnPredict(X,y,q,k,classification){const d=X.map((r,i)=>[dist(r,q),y[i]]).sort((a,b)=>a[0]-b[0]).slice(0,Math.min(k,X.length)); if(classification){const m=new Map();d.forEach(x=>m.set(x[1],(m.get(x[1])||0)+1));return [...m.entries()].sort((a,b)=>b[1]-a[1])[0][0];} return S.mean(d.map(x=>x[1]));}
function stumpTrain(X,y,classification){let best={score:Infinity,j:0,t:0,left:null,right:null};for(let j=0;j<X[0].length;j++){const vals=[...new Set(X.map(r=>r[j]))].sort((a,b)=>a-b);const candidates=vals.length>12?vals.filter((_,i)=>i%Math.ceil(vals.length/12)===0):vals;for(const t of candidates){const L=[],R=[];X.forEach((r,i)=>(r[j]<=t?L:R).push(y[i]));if(!L.length||!R.length)continue;const pred=z=>classification?mode(z):S.mean(z);const lp=pred(L),rp=pred(R);const score=classification?(L.filter(v=>v!==lp).length+R.filter(v=>v!==rp).length):(L.reduce((s,v)=>s+(v-lp)**2,0)+R.reduce((s,v)=>s+(v-rp)**2,0));if(score<best.score)best={score,j,t,left:lp,right:rp};}}return best;}
function mode(a){const m=new Map();a.forEach(v=>m.set(v,(m.get(v)||0)+1));return [...m.entries()].sort((x,y)=>y[1]-x[1])[0][0];}
function randomForestPredict(X,y,q,classification,trees=35){const preds=[];for(let z=0;z<trees;z++){const idx=Array.from({length:X.length},()=>Math.floor(Math.random()*X.length));const xx=idx.map(i=>X[i]), yy=idx.map(i=>y[i]);const st=stumpTrain(xx,yy,classification);preds.push(q[st.j]<=st.t?st.left:st.right);}return classification?mode(preds):S.mean(preds);}
function evaluateRegression(target,encoders,train,test,preds,model){const y=test.map(r=>r[target]);const mae=S.mean(preds.map((p,i)=>Math.abs(p-y[i]))),mse=S.mean(preds.map((p,i)=>(p-y[i])**2)),rmse=Math.sqrt(mse),ym=S.mean(y),sst=y.reduce((s,v)=>s+(v-ym)**2,0),ssr=preds.reduce((s,p,i)=>s+(p-y[i])**2,0),r2=sst?1-ssr/sst:NaN;return {task:'regression',target,features:encoders.map(e=>e.name),model,trainSize:train.length,testSize:test.length,metrics:{MAE:mae,MSE:mse,RMSE:rmse,R2:r2},examples:test.slice(0,8).map((r,i)=>({actual:y[i],predicted:preds[i]})),reliable:r2>0.25};}
function runRegressionAlgorithm(algorithm,target,encoders,train,test,A,B){const y=train.map(r=>r[target]);let preds,model=algorithm;if(algorithm==='KNN Regressor')preds=B.map(q=>knnPredict(A,y,q,5,false));else if(algorithm==='Decision Tree Regressor'){const st=stumpTrain(A,y,false);preds=B.map(q=>q[st.j]<=st.t?st.left:st.right);}else if(algorithm==='Random Forest Regressor')preds=B.map(q=>randomForestPredict(A,y,q,false));else throw new Error('Unsupported regression algorithm.');return evaluateRegression(target,encoders,train,test,preds,model);}
function classMetrics(classes,y,preds){const confusion={};classes.forEach(a=>{confusion[a]={};classes.forEach(b=>confusion[a][b]=0)});preds.forEach((p,i)=>confusion[y[i]][p]=(confusion[y[i]][p]||0)+1);let ps=[],rs=[],fs=[];classes.forEach(c=>{let tp=confusion[c][c]||0,fp=0,fn=0;classes.forEach(o=>{if(o!==c){fp+=confusion[o][c]||0;fn+=confusion[c][o]||0}});const p=tp+fp?tp/(tp+fp):0,r=tp+fn?tp/(tp+fn):0;ps.push(p);rs.push(r);fs.push(p+r?2*p*r/(p+r):0)});return {Accuracy:preds.filter((p,i)=>p===y[i]).length/y.length,Precision:S.mean(ps),Recall:S.mean(rs),F1:S.mean(fs),confusion};}
function runClassificationAlgorithm(algorithm,target,encoders,train,test,A,B){const y=train.map(r=>r[target]),yt=test.map(r=>r[target]),classes=[...new Set(y)];if(classes.length<2)throw new Error('Target needs at least two classes.');let preds,model=algorithm;if(algorithm==='KNN Classifier')preds=B.map(q=>knnPredict(A,y,q,7,true));else if(algorithm==='Decision Tree Classifier'){const st=stumpTrain(A,y,true);preds=B.map(q=>q[st.j]<=st.t?st.left:st.right);}else if(algorithm==='Random Forest Classifier')preds=B.map(q=>randomForestPredict(A,y,q,true));else if(algorithm==='Naive Bayes'){const stats=classes.map(c=>{const ids=y.map((v,i)=>v===c?i:-1).filter(i=>i>=0);return {c,p:ids.length/y.length,m:A[0].map((_,j)=>S.mean(ids.map(i=>A[i][j]))),sd:A[0].map((_,j)=>S.std(ids.map(i=>A[i][j]))||1)}});preds=B.map(q=>stats.map(o=>[o.c,Math.log(o.p)+q.reduce((s,v,j)=>s-0.5*Math.log(2*Math.PI*o.sd[j]**2)-((v-o.m[j])**2)/(2*o.sd[j]**2),0)]).sort((a,b)=>b[1]-a[1])[0][0]);}else if(algorithm==='SVM'){if(classes.length!==2)throw new Error('Current browser SVM supports binary classification only.');const yy=y.map(v=>v===classes[1]?1:-1),d=A[0].length;let w=new Array(d).fill(0),b=0,lr=.02,C=.8;for(let e=0;e<500;e++)for(let i=0;i<A.length;i++){const margin=yy[i]*(A[i].reduce((s,v,j)=>s+v*w[j],b));for(let j=0;j<d;j++)w[j]=w[j]*(1-lr)+(margin<1?lr*C*yy[i]*A[i][j]:0);if(margin<1)b+=lr*C*yy[i];}preds=B.map(q=>q.reduce((s,v,j)=>s+v*w[j],b)>=0?classes[1]:classes[0]);}else throw new Error('Unsupported classification algorithm.');const cm=classMetrics(classes,yt,preds);return {task:'classification',target,features:encoders.map(e=>e.name),model,trainSize:train.length,testSize:test.length,classes,metrics:{Accuracy:cm.Accuracy,Precision:cm.Precision,Recall:cm.Recall,F1:cm.F1},confusion:cm.confusion,examples:test.slice(0,8).map((r,i)=>({actual:yt[i],predicted:preds[i]})),reliable:cm.Accuracy>(1/classes.length)*1.3};}
function runKMeansModel(features){const rows=activeRows(), enc=buildFeatureMatrix(rows,features);if(!enc.length)throw new Error('Select numeric features for clustering.');const X=rows.map(r=>enc.map(e=>e.fn(r))).filter(r=>r.every(Number.isFinite));if(X.length<10)throw new Error('Need at least 10 complete rows for clustering.');const k=Math.min(4,Math.max(2,Math.round(Math.sqrt(X.length/2))));let centers=X.slice(0,k).map(r=>[...r]),labels=new Array(X.length).fill(0);for(let it=0;it<40;it++){labels=X.map(q=>centers.map(c=>dist(q,c)).indexOf(Math.min(...centers.map(c=>dist(q,c)))));centers=centers.map((c,j)=>{const pts=X.filter((_,i)=>labels[i]===j);return pts.length?c.map((_,d)=>S.mean(pts.map(r=>r[d]))):c});}return {task:'clustering',target:'None',features:enc.map(e=>e.name),model:'K-Means',trainSize:X.length,testSize:0,metrics:{Clusters:k,Rows:X.length},examples:labels.slice(0,8).map((v,i)=>({actual:'Cluster '+(v+1),predicted:'Row '+(i+1)})),reliable:true};}

function legacyRunBaselineModel(target, features, splitRatio=0.8, selectedAlgorithm=null){
  const allRows = activeRows();
  const tCol = colMeta(target);
  const encoders = buildFeatureMatrix(allRows, features);
  if(!encoders.length) throw new Error('No usable feature columns after encoding.');

  const clean = allRows.filter(r => r[target]!==null && encoders.every(e=>e.fn(r)!==null && !Number.isNaN(e.fn(r))));
  if(clean.length < 20) throw new Error('Not enough complete rows (need 20+) after removing missing values in the selected columns.');

  const shuffled = [...clean]; for(let i=shuffled.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [shuffled[i],shuffled[j]]=[shuffled[j],shuffled[i]]; }
  const splitIdx = Math.floor(shuffled.length*splitRatio);
  const train = shuffled.slice(0, splitIdx), test = shuffled.slice(splitIdx);
  if(test.length<4) throw new Error('Not enough rows for a held-out test split.');

  const X = rows => rows.map(r => encoders.map(e=>e.fn(r)));
  const Xtrain = X(train), Xtest = X(test);

  const means = encoders.map((_,j)=> S.mean(Xtrain.map(row=>row[j])) );
  const stds = encoders.map((_,j)=> { const s=S.std(Xtrain.map(row=>row[j])); return s||1; });
  const norm = M => M.map(row => row.map((v,j)=>(v-means[j])/stds[j]));
  const Xn = norm(Xtrain), Xtn = norm(Xtest);

  if(tCol.type==='numeric'){
    const ytr = train.map(r=>r[target]), yte = test.map(r=>r[target]);
    const {weights, bias} = linearRegressionGD(Xn, ytr);
    const predict = row => bias + row.reduce((s,v,j)=>s+v*weights[j],0);
    const predsTest = Xtn.map(predict);
    const mae = S.mean(predsTest.map((p,i)=>Math.abs(p-yte[i])));
    const mse = S.mean(predsTest.map((p,i)=>(p-yte[i])**2));
    const rmse = Math.sqrt(mse);
    const yMean = S.mean(yte);
    const ssTot = yte.reduce((s,v)=>s+(v-yMean)**2,0);
    const ssRes = predsTest.reduce((s,p,i)=>s+(p-yte[i])**2,0);
    const r2 = ssTot? 1-ssRes/ssTot : NaN;
    const examples = test.slice(0,8).map((r,i)=>({actual:yte[i], predicted:predsTest[i]}));
    return { task:'regression', target, features: encoders.map(e=>e.name), model:selectedAlgorithm||'Linear Regression',
      trainSize: train.length, testSize: test.length, metrics:{MAE:mae, MSE:mse, RMSE:rmse, R2:r2}, examples,
      reliable: r2 > 0.25 };
  } else {

    const classes = [...new Set(train.map(r=>r[target]))];
    if(classes.length<2) throw new Error('Target column needs at least two distinct classes.');
    if(classes.length>6) throw new Error('Too many classes for the baseline classifier (limit 6). Try a different target.');
    const classifiers = classes.map(cls=>{
      const ytr = train.map(r => r[target]===cls?1:0);
      return { cls, ...logisticRegressionGD(Xn, ytr) };
    });
    const predictProba = row => classifiers.map(c => ({cls:c.cls, p: sigmoid(c.bias + row.reduce((s,v,j)=>s+v*c.weights[j],0))}));
    const predictClass = row => predictProba(row).sort((a,b)=>b.p-a.p)[0].cls;
    const predsTest = Xtn.map(predictClass);
    const yte = test.map(r=>r[target]);
    let correct=0; predsTest.forEach((p,i)=>{ if(p===yte[i]) correct++; });
    const accuracy = correct/yte.length;

    const confusion = {};
    classes.forEach(a=>{ confusion[a]={}; classes.forEach(b=>confusion[a][b]=0); });
    predsTest.forEach((p,i)=>{ confusion[yte[i]][p] = (confusion[yte[i]][p]||0)+1; });
    let precs=[],recs=[],f1s=[];
    classes.forEach(c=>{
      let tp=confusion[c][c]||0, fp=0, fn=0;
      classes.forEach(o=>{ if(o!==c){ fp += confusion[o][c]||0; fn += confusion[c][o]||0; } });
      const prec = (tp+fp)? tp/(tp+fp) : 0, rec = (tp+fn)? tp/(tp+fn) : 0;
      const f1 = (prec+rec)? 2*prec*rec/(prec+rec) : 0;
      precs.push(prec); recs.push(rec); f1s.push(f1);
    });
    const examples = test.slice(0,8).map((r,i)=>({actual:yte[i], predicted:predsTest[i]}));
    return { task:'classification', target, features: encoders.map(e=>e.name), model:selectedAlgorithm||'Logistic Regression',
      trainSize: train.length, testSize: test.length, classes,
      metrics:{Accuracy:accuracy, Precision:S.mean(precs), Recall:S.mean(recs), F1:S.mean(f1s)}, confusion, examples,
      reliable: accuracy > (1/classes.length)*1.3 };
  }
}
function sigmoid(z){ return 1/(1+Math.exp(-z)); }
function linearRegressionGD(X, y, lr=0.1, epochs=400){
  const n=X.length, d=X[0].length;
  let weights=new Array(d).fill(0), bias=0;
  for(let e=0;e<epochs;e++){
    const gradW=new Array(d).fill(0); let gradB=0;
    for(let i=0;i<n;i++){
      const pred = bias + X[i].reduce((s,v,j)=>s+v*weights[j],0);
      const err = pred - y[i];
      for(let j=0;j<d;j++) gradW[j]+= err*X[i][j];
      gradB += err;
    }
    for(let j=0;j<d;j++) weights[j] -= lr*gradW[j]/n;
    bias -= lr*gradB/n;
  }
  return {weights, bias};
}
function logisticRegressionGD(X, y, lr=0.3, epochs=400){
  const n=X.length, d=X[0].length;
  let weights=new Array(d).fill(0), bias=0;
  for(let e=0;e<epochs;e++){
    const gradW=new Array(d).fill(0); let gradB=0;
    for(let i=0;i<n;i++){
      const pred = sigmoid(bias + X[i].reduce((s,v,j)=>s+v*weights[j],0));
      const err = pred - y[i];
      for(let j=0;j<d;j++) gradW[j]+= err*X[i][j];
      gradB += err;
    }
    for(let j=0;j<d;j++) weights[j] -= lr*gradW[j]/n;
    bias -= lr*gradB/n;
  }
  return {weights, bias};
}

function renderMlResult(res){
  const wrap = document.getElementById('mlResultWrap');
  let metricsHtml = Object.entries(res.metrics).map(([k,v])=>`
    <div class="card stat-card"><div class="stat-label">${k}</div><div class="stat-value" style="font-size:22px;">${fmtNum(v,3)}</div></div>`).join('');
  let confHtml='';
  if(res.task==='classification'){
    confHtml = `<div class="section-title"><h2>Confusion matrix</h2></div><div class="table-scroll"><table class="dl-table"><tr><th>Actual \\\\ Predicted</th>${res.classes.map(c=>`<th>${escapeHtml(String(c))}</th>`).join('')}</tr>
      ${res.classes.map(a=>`<tr><td><strong>${escapeHtml(String(a))}</strong></td>${res.classes.map(b=>`<td>${res.confusion[a][b]||0}</td>`).join('')}</tr>`).join('')}</table></div>`;
  }
  const exHtml = `<div class="table-scroll" style="margin-top:14px;"><table class="dl-table"><tr><th>#</th><th>Actual</th><th>Predicted</th></tr>
    ${res.examples.map((e,i)=>`<tr><td>${i+1}</td><td>${typeof e.actual==='number'?fmtNum(e.actual):escapeHtml(String(e.actual))}</td><td>${typeof e.predicted==='number'?fmtNum(e.predicted):escapeHtml(String(e.predicted))}</td></tr>`).join('')}
    </table></div>`;

  wrap.innerHTML = `
    <div class="card" style="margin-bottom:16px; ${res.reliable?'':'border-color:var(--warn);'}">
      <h3>${res.reliable? 'Prediction available' : 'Prediction not recommended'}</h3>
      <p style="font-size:12.5px; color:var(--ink-soft); margin-top:6px;">${res.reliable
        ? 'The baseline model shows a meaningful signal on held-out data. Treat this as a starting point, not a production-ready model.'
        : 'The baseline model performed close to a naive guess on held-out data — this target may not be well predicted by the selected features, or more data/feature engineering is needed.'}</p>
      <div class="tag-row" style="margin-top:10px;">
        <span class="badge">Target: ${escapeHtml(res.target)}</span>
        <span class="badge">Model: ${escapeHtml(res.model)}</span>
        <span class="badge">Train: ${res.trainSize} rows</span>
        <span class="badge">Test: ${res.testSize} rows</span>
        <span class="badge">Features: ${res.features.length}</span>
      </div>
    </div>
    <div class="grid cols-4">${metricsHtml}</div>
    ${confHtml}
    <div class="section-title"><h2>Prediction examples (test set)</h2></div>
    ${exHtml}
  `;
}

function renderTablePanel(){
  const body = document.getElementById('tablePanelBody');
  body.innerHTML = `
    <div class="filter-row">
      <input class="small-input" id="tblSearch" placeholder="Search all columns…" style="width:220px;">
      <select class="small-input" id="tblSource">
        <option value="cleaned" ${STATE.cleaningApplied?'selected':''}>Active dataset ${STATE.cleaningApplied?'(cleaned)':'(original)'}</option>
        <option value="original">Original dataset</option>
      </select>
      <select class="small-input" id="tblPageSize"><option>10</option><option selected>25</option><option>50</option><option>100</option></select>
      <button class="btn sm" id="tblExportBtn">Export filtered CSV</button>
      <span style="margin-left:auto; font-size:12px; color:var(--ink-faint);" id="tblCount"></span>
    </div>
    <div class="table-scroll"><table class="dl-table" id="dataTableEl"></table></div>
    <div class="filter-row" style="margin-top:10px;">
      <button class="btn sm" id="tblPrev">← Prev</button>
      <span class="mono" id="tblPageLabel" style="font-size:12px;"></span>
      <button class="btn sm" id="tblNext">Next →</button>
    </div>
  `;
  document.getElementById('tblSearch').addEventListener('input', e=>{ STATE.tableView.search=e.target.value; STATE.tableView.page=1; drawTable(); });
  document.getElementById('tblSource').addEventListener('change', e=>{ STATE.tableView.source=e.target.value; STATE.tableView.page=1; drawTable(); });
  document.getElementById('tblPageSize').addEventListener('change', e=>{ STATE.tableView.pageSize=Number(e.target.value); STATE.tableView.page=1; drawTable(); });
  document.getElementById('tblPrev').addEventListener('click', ()=>{ if(STATE.tableView.page>1){ STATE.tableView.page--; drawTable(); } });
  document.getElementById('tblNext').addEventListener('click', ()=>{ STATE.tableView.page++; drawTable(); });
  document.getElementById('tblExportBtn').addEventListener('click', exportFilteredCsv);
  drawTable();
}
function getFilteredSortedRows(){
  const src = STATE.tableView.source==='original' ? STATE.originalRows : activeRows();
  let rows = src;
  const q = STATE.tableView.search.trim().toLowerCase();
  if(q) rows = rows.filter(r => STATE.columns.some(c => r[c.name]!==null && String(r[c.name]).toLowerCase().includes(q)));
  if(STATE.tableView.sortCol){
    const col = STATE.tableView.sortCol, dir=STATE.tableView.sortDir;
    rows = [...rows].sort((a,b)=>{
      const av=a[col], bv=b[col];
      if(av===null) return 1; if(bv===null) return -1;
      if(av<bv) return -1*dir; if(av>bv) return 1*dir; return 0;
    });
  }
  return rows;
}
function drawTable(){
  const rows = getFilteredSortedRows();
  const outlierIdx = new Set();
  Object.values(STATE.outlierReport||{}).forEach(rep => rep.rows.forEach(r=>outlierIdx.add(r.rowIndex)));
  const {page, pageSize} = STATE.tableView;
  const maxPage = Math.max(1, Math.ceil(rows.length/pageSize));
  STATE.tableView.page = Math.min(page, maxPage);
  const start = (STATE.tableView.page-1)*pageSize;
  const pageRows = rows.slice(start, start+pageSize);

  const cols = STATE.columns.map(c=>c.name);
  let head = '<tr>' + cols.map(c=>`<th data-sort="${escapeHtml(c)}" style="cursor:pointer;">${escapeHtml(c)} ${STATE.tableView.sortCol===c?(STATE.tableView.sortDir===1?'↑':'↓'):''}</th>`).join('') + '</tr>';
  let body = pageRows.map(r=>{
    return '<tr>' + cols.map(c=>{
      const v = r[c];
      const isMissing = v===null;
      const globalIdx = STATE.tableView.source!=='original' ? activeRows().indexOf(r) : -1;
      const isOutlier = colMeta(c)?.type==='numeric' && globalIdx>=0 && outlierIdx.has(globalIdx);
      let display = isMissing ? 'missing' : (colMeta(c)?.type==='date' ? new Date(v).toLocaleDateString() : String(v));
      return `<td class="${isMissing?'missing-cell':''} ${isOutlier?'outlier-cell':''}">${escapeHtml(display)}</td>`;
    }).join('') + '</tr>';
  }).join('');
  document.getElementById('dataTableEl').innerHTML = head + (body || `<tr><td colspan="${cols.length}" style="color:var(--ink-faint);">No matching rows.</td></tr>`);
  document.getElementById('tblCount').textContent = `${rows.length.toLocaleString()} rows`;
  document.getElementById('tblPageLabel').textContent = `Page ${STATE.tableView.page} / ${maxPage}`;
  document.querySelectorAll('#dataTableEl th[data-sort]').forEach(th=>{
    th.addEventListener('click', ()=>{
      const c = th.dataset.sort;
      if(STATE.tableView.sortCol===c) STATE.tableView.sortDir *= -1; else { STATE.tableView.sortCol=c; STATE.tableView.sortDir=1; }
      drawTable();
    });
  });
}
function exportFilteredCsv(){
  const rows = getFilteredSortedRows();
  const csv = Papa.unparse(rows);
  download('datalens_filtered.csv', csv, 'text/csv');
  toast('Filtered CSV exported.');
}

function renderReportsPanel(){
  const body = document.getElementById('reportsPanelBody');
  body.innerHTML = `
    <div class="card" style="max-width:560px;">
      <h3 style="margin-bottom:8px;">Generate PDF Report</h3>
      <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:14px;">Includes dataset overview, data-quality summary, cleaning summary, column profiling, statistics, outlier analysis, AI insights, and ML results if available.</p>
      <button class="btn primary" id="genPdfBtn">📄 Generate PDF Report</button>
      <div id="pdfProgressWrap" style="display:none; margin-top:12px;">
        <div class="progress-track"><div class="progress-fill" id="pdfProgressFill"></div></div>
        <div style="font-size:11.5px; color:var(--ink-faint); margin-top:6px;" id="pdfProgressLabel"></div>
      </div>
    </div>
  `;
  document.getElementById('genPdfBtn').addEventListener('click', generatePdfReport);
}

async function generatePdfReport(){
  const btn = document.getElementById('genPdfBtn'); btn.disabled = true;
  const wrap = document.getElementById('pdfProgressWrap'); wrap.style.display='block';
  const fill = document.getElementById('pdfProgressFill'), label = document.getElementById('pdfProgressLabel');
  const setProg = (p,l)=>{ fill.style.width=p+'%'; label.textContent=l; };
  try{
    setProg(5,'Preparing document…');
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'pt', format:'a4'});
    const pageW = doc.internal.pageSize.getWidth(), pageH = doc.internal.pageSize.getHeight();
    const margin = 48; let y = margin;
    const brass = [140,95,40], ink=[19,27,46], soft=[100,108,125];

    function ensureSpace(h){ if(y+h > pageH-margin){ doc.addPage(); y=margin; } }
    function heading(text, size=16){ ensureSpace(30); doc.setFont('helvetica','bold'); doc.setFontSize(size); doc.setTextColor(...ink); doc.text(text, margin, y); y+=size*1.1; doc.setDrawColor(...brass); doc.setLineWidth(1); doc.line(margin,y-8,pageW-margin,y-8); y+=6; }
    function sub(text){ ensureSpace(18); doc.setFont('helvetica','bold'); doc.setFontSize(11.5); doc.setTextColor(...ink); doc.text(text, margin, y); y+=16; }
    function body(text){
      ensureSpace(14); doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(...soft);
      const lines = doc.splitTextToSize(text, pageW-2*margin);
      lines.forEach(line=>{ ensureSpace(13); doc.text(line, margin, y); y+=12.5; });
      y+=4;
    }
    function kvRow(pairs){
      ensureSpace(16);
      doc.setFontSize(9); doc.setTextColor(...ink); doc.setFont('helvetica','normal');
      const colW = (pageW-2*margin)/pairs.length;
      pairs.forEach((p,i)=>{ doc.text(`${p[0]}: ${p[1]}`, margin+i*colW, y); });
      y+=16;
    }
    function simpleTable(headers, rows, colWidths){
      ensureSpace(20);
      const totalW = pageW-2*margin;
      const w = colWidths || headers.map(()=>totalW/headers.length);
      doc.setFont('helvetica','bold'); doc.setFontSize(8.5); doc.setTextColor(255,255,255);
      doc.setFillColor(...brass);
      doc.rect(margin, y-10, totalW, 14, 'F');
      let x=margin; headers.forEach((h,i)=>{ doc.text(String(h), x+3, y); x+=w[i]; });
      y+=10;
      doc.setFont('helvetica','normal'); doc.setTextColor(...soft);
      rows.forEach((r,ri)=>{
        ensureSpace(13);
        if(ri%2===0){ doc.setFillColor(246,243,236); doc.rect(margin, y-9, totalW, 13, 'F'); }
        let x=margin; r.forEach((cell,i)=>{ doc.text(String(cell).slice(0,28), x+3, y); x+=w[i]; });
        y+=13;
      });
      y+=8;
    }

    doc.setFillColor(...ink); doc.rect(0,0,pageW,170,'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(26);
    doc.text('DataLens Analysis Report', margin, 80);
    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(220,210,190);
    doc.text(`Dataset: ${STATE.fileName}`, margin, 110);
    doc.text(`Generated: ${new Date().toLocaleString()}`, margin, 128);
    y = 200;

    setProg(15,'Writing overview…');
    heading('Dataset Overview');
    const rows = activeRows();
    kvRow([['Rows', rows.length.toLocaleString()], ['Columns', STATE.columns.length], ['Data Quality Score', dataQualityScore()+'/100']]);
    kvRow([['Numeric cols', numericCols().length], ['Categorical cols', categoricalCols().length], ['Duplicate rows', countDuplicates(rows)]]);
    y+=6;

    if(STATE.cleaningSummary){
      const s = STATE.cleaningSummary;
      sub('Cleaning Summary');
      body(`Rows before: ${s.rowsBefore} → Rows after: ${s.rowsAfter}. Duplicates removed: ${s.duplicatesRemoved}. Missing values handled: ${s.missingHandled}. Columns removed: ${s.columnsRemoved.join(', ')||'none'}.`);
    }

    setProg(28,'Writing column profile…');
    heading('Column Profiling');
    simpleTable(['Column','Type','Unique','Missing','Missing %'], STATE.columns.map(c=>[c.name,c.type,c.unique,c.missing,fmtPct(c.missingPct)]));

    setProg(40,'Writing statistics…');
    heading('Descriptive Statistics');
    const nums = numericCols();
    if(nums.length){
      simpleTable(['Column','Mean','Median','Std Dev','Min','Max'], nums.map(n=>{
        const vals = rows.map(r=>r[n]).filter(v=>v!==null);
        return [n, fmtNum(S.mean(vals)), fmtNum(S.median(vals)), fmtNum(S.std(vals)), fmtNum(S.min(vals)), fmtNum(S.max(vals))];
      }));
    } else body('No numeric columns available.');
    setProg(52,'Writing outlier analysis…');
    heading('Outlier Analysis (IQR method)');
    if(nums.length){
      simpleTable(['Column','Outliers','% of data','Lower fence','Upper fence'], nums.map(n=>{
        const r = STATE.outlierReport[n]; return [n, r.count, fmtPct(r.pct), fmtNum(r.lower), fmtNum(r.upper)];
      }));
    } else body('No numeric columns available.');
    setProg(76,'Writing insights…');
    heading('AI-Generated Insights');
    STATE.insights.slice(0,10).forEach(ins=>{
      body('• ' + ins.text.replace(/<[^>]+>/g,'') + (ins.metric ? ` (${ins.metric})` : ''));
    });

    if(STATE.mlResult){
      heading('Machine Learning Results');
      const r = STATE.mlResult;
      body(`Task: ${r.task}. Target: ${r.target}. Model: ${r.model}. Train/Test: ${r.trainSize}/${r.testSize}.`);
      simpleTable(Object.keys(r.metrics), [Object.values(r.metrics).map(v=>fmtNum(v,3))]);
      body(r.reliable ? 'This baseline shows a meaningful predictive signal on held-out data.' : 'This baseline did not show strong predictive signal — treat prediction as unreliable for this target/feature set.');
    }

    setProg(96,'Finalizing…');
    heading('Summary');
    body(`DataLens analyzed ${rows.length.toLocaleString()} rows across ${STATE.columns.length} columns from "${STATE.fileName}". Overall data quality score: ${dataQualityScore()}/100. See the sections above for detailed statistics, anomalies and (where applicable) a baseline predictive model.`);

    doc.save((STATE.fileName||'dataset').replace(/\\.csv$/i,'') + '_datalens_report.pdf');
    setProg(100,'Done — PDF downloaded.');
    toast('PDF report generated.');
  }catch(err){
    console.error(err);
    toast('PDF generation failed: '+err.message, 'err');
  }finally{
    btn.disabled=false;
    setTimeout(()=>{ document.getElementById('pdfProgressWrap').style.display='none'; }, 1200);
  }
}

function renderDownloadsPanel(){
  const body = document.getElementById('downloadsPanelBody');
  body.innerHTML = `
    <div class="grid cols-3">
      <div class="card"><h3>Cleaned CSV</h3><p class="stat-sub">Current active dataset.</p><button class="btn" id="dlCleaned" style="margin-top:10px;">⤓ Download</button></div>
      <div class="card"><h3>Original CSV</h3><p class="stat-sub">Untouched upload.</p><button class="btn" id="dlOriginal" style="margin-top:10px;">⤓ Download</button></div>
      <div class="card"><h3>Statistics</h3><p class="stat-sub">CSV + JSON.</p><div style="display:flex; gap:6px; margin-top:10px;"><button class="btn sm" id="dlStatsCsv">CSV</button><button class="btn sm" id="dlStatsJson">JSON</button></div></div>
      <div class="card"><h3>AI Insights</h3><p class="stat-sub">TXT + JSON.</p><div style="display:flex; gap:6px; margin-top:10px;"><button class="btn sm" id="dlInsightsTxt">TXT</button><button class="btn sm" id="dlInsightsJson">JSON</button></div></div>
      <div class="card"><h3>ML results</h3><p class="stat-sub">${STATE.mlResult? 'Model metrics + predictions.' : 'Run a model under Machine Learning first.'}</p><button class="btn" id="dlMl" style="margin-top:10px;" ${STATE.mlResult?'':'disabled'}>⤓ Download</button></div>
      <div class="card"><h3>PDF report</h3><p class="stat-sub">Full formatted report.</p><button class="btn" id="dlPdfShortcut" style="margin-top:10px;">Go to Reports →</button></div>
    </div>
    <div class="card" style="margin-top:20px; background:var(--ink); color:var(--paper);" >
      <h3 style="color:var(--paper);">Download everything</h3>
      <p style="font-size:12.5px; opacity:.8; margin:6px 0 12px;">A single ZIP with original data, cleaned data, statistics, insights, ML results (if run) and the PDF report. Only files that actually exist are included.</p>
      <button class="btn" style="background:var(--brass); border-color:var(--brass); color:#1a1206;" id="dlEverythingBtn">⤓ Download Everything (.zip)</button>
      <div id="zipProgress" style="display:none; margin-top:10px;"><div class="progress-track"><div class="progress-fill" id="zipProgressFill"></div></div><div style="font-size:11.5px; opacity:.75; margin-top:6px;" id="zipProgressLabel"></div></div>
    </div>
  `;
  document.getElementById('dlCleaned').addEventListener('click', ()=>{ download('cleaned_dataset.csv', Papa.unparse(activeRows()), 'text/csv'); toast('Cleaned CSV downloaded.'); });
  document.getElementById('dlOriginal').addEventListener('click', ()=>{ download('original_dataset.csv', Papa.unparse(STATE.originalRows), 'text/csv'); toast('Original CSV downloaded.'); });
  document.getElementById('dlStatsCsv').addEventListener('click', ()=>{ download('statistics.csv', buildStatsCsv(), 'text/csv'); });
  document.getElementById('dlStatsJson').addEventListener('click', ()=>{ download('statistics.json', JSON.stringify(buildStatsObj(),null,2), 'application/json'); });
  document.getElementById('dlInsightsTxt').addEventListener('click', ()=>{ download('ai_insights.txt', STATE.insights.map(i=>'- '+i.text.replace(/<[^>]+>/g,'')).join('\\n'), 'text/plain'); });
  document.getElementById('dlInsightsJson').addEventListener('click', ()=>{ download('ai_insights.json', JSON.stringify(STATE.insights.map(i=>({...i,text:i.text.replace(/<[^>]+>/g,'')})),null,2), 'application/json'); });
  document.getElementById('dlMl')?.addEventListener('click', ()=>{ if(STATE.mlResult) download('model_results.json', JSON.stringify(STATE.mlResult,null,2), 'application/json'); });
  document.getElementById('dlPdfShortcut').addEventListener('click', ()=>switchPanel('reports'));
  document.getElementById('dlEverythingBtn').addEventListener('click', downloadEverything);
}
function buildStatsObj(){
  const rows = activeRows();
  const numeric = {}; numericCols().forEach(n=>{
    const vals = rows.map(r=>r[n]).filter(v=>v!==null); const s=vals.slice().sort((a,b)=>a-b);
    numeric[n] = { count:vals.length, mean:S.mean(vals), median:S.median(vals), mode:S.mode(vals), min:S.min(vals), max:S.max(vals), std:S.std(vals), variance:S.variance(vals), q1:S.percentile(s,25), q3:S.percentile(s,75) };
  });
  const categorical = {}; categoricalCols().forEach(n=>{
    const vals = rows.map(r=>r[n]).filter(v=>v!==null); const freq=new Map(); vals.forEach(v=>freq.set(v,(freq.get(v)||0)+1));
    categorical[n] = { unique: freq.size, top: S.mode(vals), frequencyTable: Object.fromEntries(freq) };
  });
  return {numeric, categorical};
}
function buildStatsCsv(){
  const obj = buildStatsObj();
  const rows = [['column','metric','value']];
  Object.entries(obj.numeric).forEach(([col,m])=> Object.entries(m).forEach(([k,v])=> rows.push([col,k,v])));
  Object.entries(obj.categorical).forEach(([col,m])=>{ rows.push([col,'unique',m.unique]); rows.push([col,'top',m.top]); });
  return Papa.unparse(rows);
}
function buildSummaryObj(){
  return {
    fileName: STATE.fileName, generatedAt: new Date().toISOString(),
    rows: activeRows().length, columns: STATE.columns.length, dataQualityScore: dataQualityScore(),
    duplicates: countDuplicates(activeRows()), cleaningApplied: STATE.cleaningApplied, cleaningSummary: STATE.cleaningSummary,
    columnProfile: STATE.columns, outliers: STATE.outlierReport,
    insights: STATE.insights.map(i=>({...i,text:i.text.replace(/<[^>]+>/g,'')})),
    ml: STATE.mlResult,
  };
}
async function downloadEverything(){
  const wrap = document.getElementById('zipProgress'); wrap.style.display='block';
  const fill = document.getElementById('zipProgressFill'), label = document.getElementById('zipProgressLabel');
  const setProg=(p,l)=>{ fill.style.width=p+'%'; label.textContent=l; };
  try{
    setProg(5,'Packing original data…');
    const zip = new JSZip();
    zip.folder('original').file('original_dataset.csv', Papa.unparse(STATE.originalRows));
    setProg(15,'Packing cleaned data…');
    zip.folder('cleaned').file('cleaned_dataset.csv', Papa.unparse(activeRows()));
    setProg(25,'Packing statistics…');
    const statsFolder = zip.folder('statistics');
    statsFolder.file('statistics.csv', buildStatsCsv());
    statsFolder.file('statistics.json', JSON.stringify(buildStatsObj(),null,2));
    setProg(55,'Packing insights…');
    const insightsFolder = zip.folder('insights');
    insightsFolder.file('ai_insights.txt', STATE.insights.map(i=>'- '+i.text.replace(/<[^>]+>/g,'')).join('\\n'));
    insightsFolder.file('ai_insights.json', JSON.stringify(STATE.insights.map(i=>({...i,text:i.text.replace(/<[^>]+>/g,'')})),null,2));
    if(STATE.mlResult){
      setProg(68,'Packing ML results…');
      const mlFolder = zip.folder('ml');
      mlFolder.file('model_results.json', JSON.stringify(STATE.mlResult,null,2));
      const predCsv = Papa.unparse(STATE.mlResult.examples.map((e,i)=>({row:i+1, actual:e.actual, predicted:e.predicted})));
      mlFolder.file('predictions.csv', predCsv);
    }
    setProg(80,'Packing report…');
    try{
      const { jsPDF } = window.jspdf;
      if(jsPDF){

        const pdfBlob = await buildPdfBlob();
        if(pdfBlob) zip.folder('reports').file('analysis_report.pdf', pdfBlob);
      }
    }catch(e){ console.warn('PDF embed in zip skipped', e); }
    setProg(90,'Packing summary…');
    zip.folder('summary').file('analysis_summary.json', JSON.stringify(buildSummaryObj(),null,2));
    setProg(96,'Compressing…');
    const blob = await zip.generateAsync({type:'blob'});
    downloadBlob((STATE.fileName||'dataset').replace(/\\.csv$/i,'')+'_datalens_everything.zip', blob);
    setProg(100,'Done.');
    toast('Everything downloaded as ZIP.');
  }catch(err){
    console.error(err);
    toast('Could not build the ZIP package: '+err.message, 'err');
  }finally{
    setTimeout(()=>{ wrap.style.display='none'; }, 1000);
  }
}
async function buildPdfBlob(){
  try{
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'pt', format:'a4'});
    doc.setFont('helvetica','bold'); doc.setFontSize(20); doc.text('DataLens Analysis Report', 48, 60);
    doc.setFont('helvetica','normal'); doc.setFontSize(10);
    doc.text(`Dataset: ${STATE.fileName}`, 48, 84);
    doc.text(`Rows: ${activeRows().length} · Columns: ${STATE.columns.length} · Quality: ${dataQualityScore()}/100`, 48, 100);
    doc.text('Full interactive report available via Reports tab. This is a condensed copy for the ZIP bundle.', 48, 120);
    let y=150;
    STATE.insights.slice(0,12).forEach(ins=>{
      const lines = doc.splitTextToSize('• '+ins.text.replace(/<[^>]+>/g,''), 500);
      lines.forEach(l=>{ if(y>780){ doc.addPage(); y=48; } doc.text(l,48,y); y+=13; });
    });
    return doc.output('blob');
  }catch(e){ return null; }
}



const ENH = {
  datasetView:{search:'',visible:new Set(),showAll:false},
  history:[],
  versions:{original:null,cleaned:null},
  selectedVersion:'active',
  originalColumns:null
};

function enhSnapshot(label){
  ENH.history.push({label,time:new Date().toLocaleTimeString(),rows:activeRows().map(r=>({...r})),columns:STATE.columns.map(c=>({...c}))});
  if(ENH.history.length>12) ENH.history.shift();
}
function enhRestoreColumns(){ if(ENH.originalColumns) STATE.columns=ENH.originalColumns.map(c=>({...c})); }
function enhEnsureVersionState(){
  if(!ENH.versions.original && STATE.originalRows.length){ ENH.versions.original=STATE.originalRows.map(r=>({...r})); ENH.originalColumns=STATE.columns.map(c=>({...c})); }
  if(!ENH.datasetView.visible.size) STATE.columns.forEach(c=>ENH.datasetView.visible.add(c.name));
}
function qualityAlerts(){
  const rows=activeRows(), alerts=[];
  if(!rows.length) return alerts;
  const total=Math.max(1,rows.length*STATE.columns.length);
  const miss=STATE.columns.reduce((a,c)=>a+rows.filter(r=>r[c.name]===null||r[c.name]===undefined).length,0);
  const dup=countDuplicates(rows);
  if(miss) alerts.push({kind:'warn',text:`${miss.toLocaleString()} missing values detected (${fmtPct(miss/total*100)} of all cells).`});
  if(dup) alerts.push({kind:'warn',text:`${dup.toLocaleString()} duplicate rows detected.`});
  STATE.columns.filter(c=>c.constant).forEach(c=>alerts.push({kind:'info',text:`Column "${c.name}" contains only one repeated value.`}));
  const ids=STATE.columns.filter(c=>c.looksId); if(ids.length) alerts.push({kind:'info',text:`ID-like columns detected: ${ids.map(c=>c.name).join(', ')}.`});
  if(!alerts.length) alerts.push({kind:'good',text:'No major data-quality issues detected.'});
  return alerts;
}

const _bootstrapDataset=bootstrapDataset;
bootstrapDataset=function(fields,rows,delimiter){
  _bootstrapDataset(fields,rows,delimiter);
  ENH.versions.original=STATE.originalRows.map(r=>({...r}));
  ENH.versions.cleaned=null; ENH.selectedVersion='active'; ENH.history=[];
  ENH.originalColumns=STATE.columns.map(c=>({...c}));
  ENH.datasetView.visible=new Set(STATE.columns.map(c=>c.name)); ENH.datasetView.search=''; ENH.datasetView.showAll=false;
  renderDashboard(); renderDatasetPanel(); renderCleaningPanel(); renderStatsPanel();
};

const _renderDashboard=renderDashboard;
renderDashboard=function(){
  _renderDashboard();
  if(!activeRows().length) return;
  const dash=document.getElementById('panel-dashboard'); if(!dash) return;
  let box=document.getElementById('enhancedDashboardBox');
  if(!box){ box=document.createElement('div'); box.id='enhancedDashboardBox'; box.style.marginTop='18px'; dash.querySelector('.panel-inner')?.appendChild(box); }
  const alerts=qualityAlerts();
  box.innerHTML=`<div class="grid cols-4"><div class="card"><div class="stat-label">Dataset Health</div><div class="health-ring">${dataQualityScore()}<span style="font-size:16px;letter-spacing:0">/100</span></div><div class="stat-sub">Overall data quality score</div></div><div class="card"><div class="stat-label">Dataset Version</div><div class="stat-value" style="font-size:20px;">${STATE.cleaningApplied?'Cleaned':'Original'}</div><div class="stat-sub">Original data always preserved</div></div><div class="card"><div class="stat-label">Cleaning Actions</div><div class="stat-value">${ENH.history.length}</div><div class="stat-sub">Operations in current session</div></div><div class="card"><div class="stat-label">Quality Alerts</div><div class="stat-value">${alerts.length}</div><div class="stat-sub">Automatic checks</div></div></div><div class="section-title" style="margin-top:18px"><h2>Data Quality Alerts</h2></div><div class="quality-alerts">${alerts.map(a=>`<div class="quality-alert">${a.kind==='warn'?'⚠️':a.kind==='good'?'✓':'ℹ️'} ${escapeHtml(a.text)}</div>`).join('')}</div>`;
};

function enhFilteredRows(){
  const q=ENH.datasetView.search.trim().toLowerCase(); const rows=activeRows();
  if(!q) return rows;
  return rows.filter(r=>STATE.columns.some(c=>String(r[c.name]??'').toLowerCase().includes(q)));
}
function enhDatasetTable(rows,cols){
  const limit=ENH.datasetView.showAll?rows.length:Math.min(50,rows.length); const show=rows.slice(0,limit);
  let html=`<div class="table-scroll"><table class="dl-table full-data-table"><thead><tr><th>#</th>${cols.map(c=>`<th>${escapeHtml(c)}</th>`).join('')}</tr></thead><tbody>`;
  html+=show.map((r,i)=>`<tr><td>${i+1}</td>${cols.map(c=>`<td>${r[c]===null||r[c]===undefined?'—':escapeHtml(String(r[c]))}</td>`).join('')}</tr>`).join('');
  html+='</tbody></table></div>';
  if(rows.length>limit) html+=`<div class="hint" style="margin-top:8px">Showing ${limit.toLocaleString()} of ${rows.length.toLocaleString()} matching rows.</div>`;
  return html;
}
renderDatasetPanel=function(){
  enhEnsureVersionState();
  const body=document.getElementById('datasetPanelBody'); if(!body) return;
  const rows=enhFilteredRows(); const visible=STATE.columns.map(c=>c.name).filter(n=>ENH.datasetView.visible.has(n));
  body.innerHTML=`<div class="version-tabs"><button data-version="original" class="${ENH.selectedVersion==='original'?'active':''}">Original Dataset</button><button data-version="active" class="${ENH.selectedVersion==='active'?'active':''}">Active Dataset</button><button id="datasetResetView">Reset View</button></div><div class="grid cols-4"><div class="card stat-card"><div class="stat-label">Rows</div><div class="stat-value">${activeRows().length.toLocaleString()}</div></div><div class="card stat-card"><div class="stat-label">Columns</div><div class="stat-value">${STATE.columns.length}</div></div><div class="card stat-card"><div class="stat-label">Visible Columns</div><div class="stat-value">${visible.length}</div></div><div class="card stat-card"><div class="stat-label">Data Quality</div><div class="stat-value">${dataQualityScore()}/100</div></div></div><div class="dataset-toolbar"><input id="datasetSearch" class="pill-select" placeholder="Search across all rows and columns..." value="${escapeHtml(ENH.datasetView.search)}"><button class="btn" id="toggleColsBtn">Choose Columns</button><button class="btn primary" id="datasetShowAllBtn">${ENH.datasetView.showAll?'Show Less':'Show All'}</button></div><div id="columnPickerWrap" style="display:none" class="column-picker">${STATE.columns.map(c=>`<label><input type="checkbox" value="${escapeHtml(c.name)}" ${ENH.datasetView.visible.has(c.name)?'checked':''}> ${escapeHtml(c.name)} <span class="badge ${c.type}">${c.type}</span></label>`).join('')}</div><div class="card"><div style="margin-bottom:10px"><strong>${rows.length.toLocaleString()} matching rows × ${visible.length} visible columns</strong><div class="hint">Search, choose visible columns, then Show All or Show Less. Scroll horizontally for wide data.</div></div><div id="enhDatasetTable">${enhDatasetTable(rows,visible)}</div></div><div class="section-title"><h2>Column Explorer</h2></div><div class="grid cols-4">${STATE.columns.map(c=>`<div class="card col-card" data-explore-col="${escapeHtml(c.name)}"><div class="stat-label">${escapeHtml(c.name)}</div><div class="stat-value" style="font-size:17px">${c.type}</div><div class="stat-sub">Unique: ${c.unique} · Missing: ${c.missing}</div></div>`).join('')}</div><div id="columnExplorerOut" style="margin-top:14px"></div>`;
  body.querySelector('#datasetSearch').addEventListener('input',e=>{ENH.datasetView.search=e.target.value; ENH.datasetView.showAll=false; renderDatasetPanel();});
  body.querySelector('#datasetShowAllBtn').addEventListener('click',()=>{ENH.datasetView.showAll=!ENH.datasetView.showAll; renderDatasetPanel();});
  body.querySelector('#toggleColsBtn').addEventListener('click',()=>{const w=body.querySelector('#columnPickerWrap'); w.style.display=w.style.display==='none'?'block':'none';});
  body.querySelectorAll('#columnPickerWrap input').forEach(x=>x.addEventListener('change',()=>{x.checked?ENH.datasetView.visible.add(x.value):ENH.datasetView.visible.delete(x.value); renderDatasetPanel();}));
  body.querySelector('#datasetResetView').addEventListener('click',()=>{ENH.datasetView.search='';ENH.datasetView.showAll=false;ENH.datasetView.visible=new Set(STATE.columns.map(c=>c.name));renderDatasetPanel();});
  body.querySelectorAll('[data-explore-col]').forEach(el=>el.addEventListener('click',()=>enhShowColumnExplorer(el.dataset.exploreCol)));
};
function enhShowColumnExplorer(name){
  const c=colMeta(name), rows=activeRows(), vals=rows.map(r=>r[name]).filter(v=>v!==null&&v!==undefined); const out=document.getElementById('columnExplorerOut'); if(!out||!c)return;
  let extra='';
  if(c.type==='numeric'){ const a=vals.map(Number).filter(Number.isFinite); extra=`<div class="grid cols-4"><div class="card stat-card"><div class="stat-label">Min</div><div class="stat-value">${fmtNum(S.min(a))}</div></div><div class="card stat-card"><div class="stat-label">Max</div><div class="stat-value">${fmtNum(S.max(a))}</div></div><div class="card stat-card"><div class="stat-label">Mean</div><div class="stat-value">${fmtNum(S.mean(a))}</div></div><div class="card stat-card"><div class="stat-label">Median</div><div class="stat-value">${fmtNum(S.median(a))}</div></div></div>`; }
  else {const f=new Map();vals.forEach(v=>f.set(String(v),(f.get(String(v))||0)+1));const top=[...f.entries()].sort((a,b)=>b[1]-a[1]).slice(0,5);extra=`<div class="card"><strong>Top values</strong><div class="quality-alerts">${top.map(([v,n])=>`<div class="quality-alert">${escapeHtml(v)} — ${n.toLocaleString()}</div>`).join('')}</div></div>`;}
  out.innerHTML=`<div class="section-title"><h2>${escapeHtml(name)} — Column Explorer</h2></div><div class="card"><p class="hint">Type: ${c.type} · Unique: ${c.unique} · Missing: ${c.missing} (${fmtPct(c.missingPct)})</p></div>${extra}`;
  out.scrollIntoView({behavior:'smooth',block:'nearest'});
}

const _applyCleaning=applyCleaning;
applyCleaning=function(selectedIds){
  enhSnapshot('Before cleaning');
  enhRestoreColumns();
  _applyCleaning(selectedIds);
  ENH.versions.cleaned=STATE.cleanedRows?STATE.cleanedRows.map(r=>({...r})):null;
  ENH.history.push({label:'Applied selected cleaning actions',time:new Date().toLocaleTimeString(),rows:activeRows().map(r=>({...r})),columns:STATE.columns.map(c=>({...c}))});
  renderCleaningPanel();
};
const _renderCleaningPanel=renderCleaningPanel;
renderCleaningPanel=function(){
  _renderCleaningPanel();
  const body=document.getElementById('cleaningPanelBody'); if(!body||!activeRows().length)return;
  let hist=document.createElement('div'); hist.className='clean-history';
  hist.innerHTML=`<div class="section-title"><h2>Cleaning History & Versions</h2></div><div class="version-tabs"><button id="undoCleaningBtn" ${ENH.history.length?'':'disabled'}>Undo Last</button><button id="resetAllCleaningBtn">Reset to Original</button></div>${ENH.history.length?ENH.history.slice().reverse().map((h,i)=>`<div class="history-item">${ENH.history.length-i}. ${escapeHtml(h.label)} · ${h.time}</div>`).join(''):'<div class="hint">No cleaning actions yet.</div>'}`;
  body.appendChild(hist);
  hist.querySelector('#undoCleaningBtn')?.addEventListener('click',()=>{const snap=ENH.history.pop(); if(!snap)return; STATE.cleanedRows=snap.rows;STATE.columns=snap.columns;STATE.cleaningApplied=true;STATE.cleaningSummary={rowsBefore:STATE.originalRows.length,rowsAfter:snap.rows.length,duplicatesRemoved:0,missingHandled:0,columnsConverted:0,columnsRemoved:[],invalidHandled:0}; recomputeAllDerived();renderCleaningPanel();toast('Last cleaning step restored.');});
  hist.querySelector('#resetAllCleaningBtn')?.addEventListener('click',()=>{enhRestoreColumns();STATE.cleanedRows=null;STATE.cleaningApplied=false;STATE.cleaningSummary=null;ENH.history=[];ENH.versions.cleaned=null;recomputeAllDerived();renderCleaningPanel();toast('Dataset reset to original.');});
};

const _renderStatsPanel=renderStatsPanel;
renderStatsPanel=function(){ _renderStatsPanel(); };

function switchPanel(name){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  const panel=document.getElementById('panel-'+name);
  if(panel) panel.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active', n.dataset.panel===name));

  if(activeRows().length){
    try{
      if(name==='outliers'){ computeOutliers(); renderOutliersPanel(); }
      else if(name==='insights'){ generateInsights(); renderInsightsPanel(); }
      else if(name==='dataset') renderDatasetPanel();
      else if(name==='cleaning') renderCleaningPanel();
      else if(name==='stats') renderStatsPanel();
      else if(name==='table') renderTablePanel();
    }catch(err){
      console.error('Panel render error:', name, err);
      const target=document.getElementById(name==='stats'?'statsPanelBody':name==='dataset'?'datasetPanelBody':name==='cleaning'?'cleaningPanelBody':name==='outliers'?'outliersPanelBody':name==='insights'?'insightsPanelBody':name==='table'?'tablePanelBody':null);
      if(target) target.innerHTML='<div class=\"empty-state\"><h3>Unable to render this panel</h3><p>'+escapeHtml(err.message||String(err))+'</p></div>';
    }
  }
  window.scrollTo({top:0, behavior:'instant'});
  if(window.innerWidth<=900) document.getElementById('sidebar').classList.remove('open');
}
document.getElementById('navList').addEventListener('click', e=>{
  const item = e.target.closest('.nav-item'); if(!item) return;
  switchPanel(item.dataset.panel);
});
document.getElementById('menuToggle').addEventListener('click', ()=> document.getElementById('sidebar').classList.toggle('open'));
document.getElementById('quickDownloadBtn').addEventListener('click', ()=>switchPanel('downloads'));

const themePref = 'dark';
function getThemePref(){ return 'dark'; }
document.documentElement.setAttribute('data-theme', 'dark');
try{ window.storage?.set('datalens-theme', 'dark', false); }catch(e){}
</script>

<script>
/* DataLens ML Professional Upgrade */
(function(){
const METRIC_LABELS={MAE:'Mean Absolute Error',MSE:'Mean Squared Error',RMSE:'Root Mean Squared Error',R2:'Coefficient of Determination (R-Squared)',Accuracy:'Classification Accuracy',Precision:'Precision Score',Recall:'Recall Score',F1:'F1 Score',Clusters:'Number of Clusters',Rows:'Rows Analysed',Inertia:'Cluster Inertia'};
function seededRandom(seed){let x=(seed>>>0)||123456789;return()=>{x=(1664525*x+1013904223)>>>0;return x/4294967296}}
function shuffleSeeded(a,seed){const r=[...a],rnd=seededRandom(seed);for(let i=r.length-1;i>0;i--){const j=Math.floor(rnd()*(i+1));[r[i],r[j]]=[r[j],r[i]]}return r}
function buildEncodersFromTrain(train,features){const out=[];for(const f of features){const c=colMeta(f);if(c.type==='numeric')out.push({name:f,fn:r=>Number(r[f])});else if(c.type==='boolean')out.push({name:f,fn:r=>r[f]?1:0});else{const vals=[...new Set(train.map(r=>r[f]).filter(v=>v!==null&&v!==undefined&&v!==''))];if(vals.length<=12){for(const v of vals)out.push({name:f+'='+v,fn:r=>r[f]===v?1:0})}else{const freq=new Map();train.forEach(r=>freq.set(r[f],(freq.get(r[f])||0)+1));out.push({name:f+' (frequency)',fn:r=>freq.get(r[f])||0})}}}return out}
function matrix(rows,enc){return rows.map(r=>enc.map(e=>e.fn(r)))}
function standardizeTrainTest(A,B){const means=A[0].map((_,j)=>S.mean(A.map(r=>r[j]))),stds=A[0].map((_,j)=>S.std(A.map(r=>r[j]))||1);return {A:A.map(r=>r.map((v,j)=>(v-means[j])/stds[j])),B:B.map(r=>r.map((v,j)=>(v-means[j])/stds[j])),means,stds}}
function leaf(y,cls){return cls?mode(y):S.mean(y)}
function impurity(y,cls){if(!y.length)return 0;if(!cls){const m=S.mean(y);return y.reduce((s,v)=>s+(v-m)**2,0)}const counts={};y.forEach(v=>counts[v]=(counts[v]||0)+1);return y.length-Math.max(...Object.values(counts))}
function trainTree(X,y,cls,maxDepth=5,minLeaf=3,depth=0,features=null){const node={value:leaf(y,cls),n:y.length};if(depth>=maxDepth||y.length<minLeaf*2||new Set(y).size===1)return node;let best=null;const dims=features||[...Array(X[0].length).keys()];for(const j of dims){const vals=[...new Set(X.map(r=>r[j]))].sort((a,b)=>a-b);const step=Math.max(1,Math.ceil(vals.length/18));for(let k=step;k<vals.length;k+=step){const t=(vals[k-1]+vals[k])/2,L=[],R=[];X.forEach((r,i)=>(r[j]<=t?L:R).push(i));if(L.length<minLeaf||R.length<minLeaf)continue;const score=impurity(L.map(i=>y[i]),cls)+impurity(R.map(i=>y[i]),cls);if(!best||score<best.score)best={score,j,t,L,R}}}if(!best)return node;node.j=best.j;node.t=best.t;node.left=trainTree(best.L.map(i=>X[i]),best.L.map(i=>y[i]),cls,maxDepth,minLeaf,depth+1,features);node.right=trainTree(best.R.map(i=>X[i]),best.R.map(i=>y[i]),cls,maxDepth,minLeaf,depth+1,features);return node}
function predictTree(t,q){while(t&&t.j!==undefined)t=q[t.j]<=t.t?t.left:t.right;return t?.value}
function trainForest(X,y,cls,trees=45,seed=42){const rnd=seededRandom(seed),d=X[0].length,forest=[],importance=new Array(d).fill(0);for(let z=0;z<trees;z++){const ids=Array.from({length:X.length},()=>Math.floor(rnd()*X.length));const subset=Math.max(1,Math.floor(Math.sqrt(d))),idx=[...Array(d).keys()].sort(()=>rnd()-.5).slice(0,subset);const tr=trainTree(ids.map(i=>X[i]),ids.map(i=>y[i]),cls,6,3,0,idx);forest.push(tr);(function walk(n){if(!n||n.j===undefined)return;importance[n.j]++;walk(n.left);walk(n.right)})(tr)}return {forest,importance}}
function predictForest(f,q,cls){const ps=f.forest.map(t=>predictTree(t,q));return cls?mode(ps):S.mean(ps)}
function importanceRows(enc,imp){const total=imp.reduce((a,b)=>a+b,0)||1;return enc.map((e,i)=>({feature:e.name,importance:(imp[i]||0)/total})).sort((a,b)=>b.importance-a.importance)}
function evaluateReg(target,enc,train,test,preds,model,importance=[]){const y=test.map(r=>Number(r[target])),mae=S.mean(preds.map((p,i)=>Math.abs(p-y[i]))),mse=S.mean(preds.map((p,i)=>(p-y[i])**2)),rmse=Math.sqrt(mse),ym=S.mean(y),sst=y.reduce((s,v)=>s+(v-ym)**2,0),ssr=preds.reduce((s,p,i)=>s+(p-y[i])**2,0),r2=sst?1-ssr/sst:0;return {task:'regression',target,features:enc.map(e=>e.name),model,trainSize:train.length,testSize:test.length,metrics:{MAE:mae,MSE:mse,RMSE:rmse,R2:r2},examples:test.slice(0,8).map((r,i)=>({actual:y[i],predicted:preds[i]})),importance,reliable:r2>0.25}}
function runSupervised(target,features,algorithm,split=.8,seed=42){const all=activeRows().filter(r=>r[target]!==null&&r[target]!==undefined&&r[target]!=='');if(all.length<20)throw Error('Need at least 20 valid target rows.');const shuffled=shuffleSeeded(all,seed),cut=Math.max(10,Math.min(shuffled.length-5,Math.floor(shuffled.length*split))),trainRaw=shuffled.slice(0,cut),testRaw=shuffled.slice(cut),enc=buildEncodersFromTrain(trainRaw,features);if(!enc.length)throw Error('No usable feature columns.');const valid=r=>enc.every(e=>Number.isFinite(e.fn(r)));const train=trainRaw.filter(valid),test=testRaw.filter(valid);if(train.length<10||test.length<3)throw Error('Too few complete rows after preprocessing.');let A=matrix(train,enc),B=matrix(test,enc),scaled=standardizeTrainTest(A,B);A=scaled.A;B=scaled.B;const numeric=colMeta(target).type==='numeric';if(numeric){const y=train.map(r=>Number(r[target]));let preds,importance=[];if(algorithm==='Linear Regression'){const m=linearRegressionGD(A,y,.08,700);preds=B.map(q=>m.bias+q.reduce((s,v,j)=>s+v*m.weights[j],0));importance=enc.map((e,i)=>({feature:e.name,importance:Math.abs(m.weights[i])}));}else if(algorithm==='KNN Regressor')preds=B.map(q=>knnPredict(A,y,q,5,false));else if(algorithm==='Decision Tree Regressor'){const t=trainTree(A,y,false,7,3);preds=B.map(q=>predictTree(t,q));const imp=new Array(enc.length).fill(0);(function w(n){if(!n||n.j===undefined)return;imp[n.j]++;w(n.left);w(n.right)})(t);importance=importanceRows(enc,imp)}else if(algorithm==='Random Forest Regressor'){const f=trainForest(A,y,false,55,seed);preds=B.map(q=>predictForest(f,q,false));importance=importanceRows(enc,f.importance)}else throw Error('Unsupported regression algorithm.');return evaluateReg(target,enc,train,test,preds,algorithm,importance)}
const y=train.map(r=>String(r[target])),yt=test.map(r=>String(r[target])),classes=[...new Set(y)];if(classes.length<2)throw Error('Classification target needs at least two classes.');let preds,importance=[];if(algorithm==='Logistic Regression'){if(classes.length!==2)throw Error('Logistic Regression currently supports binary targets. Choose a binary target or another classifier.');const yy=y.map(v=>v===classes[1]?1:0),m=logisticRegressionGD(A,yy,.15,700);preds=B.map(q=>sigmoid(m.bias+q.reduce((s,v,j)=>s+v*m.weights[j],0))>=.5?classes[1]:classes[0]);importance=enc.map((e,i)=>({feature:e.name,importance:Math.abs(m.weights[i])}));}else if(algorithm==='KNN Classifier')preds=B.map(q=>knnPredict(A,y,q,7,true));else if(algorithm==='Decision Tree Classifier'){const t=trainTree(A,y,true,7,3);preds=B.map(q=>predictTree(t,q));}else if(algorithm==='Random Forest Classifier'){const f=trainForest(A,y,true,55,seed);preds=B.map(q=>predictForest(f,q,true));importance=importanceRows(enc,f.importance)}else if(algorithm==='Naive Bayes'){const stats=classes.map(c=>{const ids=y.map((v,i)=>v===c?i:-1).filter(i=>i>=0);return {c,p:ids.length/y.length,m:A[0].map((_,j)=>S.mean(ids.map(i=>A[i][j]))),sd:A[0].map((_,j)=>S.std(ids.map(i=>A[i][j]))||1)}});preds=B.map(q=>stats.map(o=>[o.c,Math.log(o.p)+q.reduce((s,v,j)=>s-.5*Math.log(2*Math.PI*o.sd[j]**2)-((v-o.m[j])**2)/(2*o.sd[j]**2),0)]).sort((a,b)=>b[1]-a[1])[0][0])}else if(algorithm==='SVM'){if(classes.length!==2)throw Error('SVM currently supports binary classification only.');const yy=y.map(v=>v===classes[1]?1:-1),d=A[0].length;let w=new Array(d).fill(0),b=0;for(let e=0;e<700;e++)for(let i=0;i<A.length;i++){const margin=yy[i]*(A[i].reduce((s,v,j)=>s+v*w[j],b));for(let j=0;j<d;j++)w[j]=w[j]*(1-.01)+(margin<1?.01*.8*yy[i]*A[i][j]:0);if(margin<1)b+=.01*.8*yy[i]}preds=B.map(q=>q.reduce((s,v,j)=>s+v*w[j],b)>=0?classes[1]:classes[0])}else throw Error('Unsupported classification algorithm.');const cm=classMetrics(classes,yt,preds);return {task:'classification',target,features:enc.map(e=>e.name),model:algorithm,trainSize:train.length,testSize:test.length,classes,metrics:{Accuracy:cm.Accuracy,Precision:cm.Precision,Recall:cm.Recall,F1:cm.F1},confusion:cm.confusion,examples:test.slice(0,8).map((r,i)=>({actual:yt[i],predicted:preds[i]})),importance,reliable:cm.Accuracy>(1/classes.length)*1.3}}
function runKMeansProfessional(features,k=3,seed=42){const rows=activeRows(),enc=buildEncodersFromTrain(rows,features),X=matrix(rows.filter(r=>enc.every(e=>Number.isFinite(e.fn(r)))),enc);if(X.length<10)throw Error('Need at least 10 complete rows for clustering.');const means=X[0].map((_,j)=>S.mean(X.map(r=>r[j]))),stds=X[0].map((_,j)=>S.std(X.map(r=>r[j]))||1);const Z=X.map(r=>r.map((v,j)=>(v-means[j])/stds[j]));const rnd=seededRandom(seed),centers=[];centers.push([...Z[Math.floor(rnd()*Z.length)]]);while(centers.length<k){let best=Z[0],bd=-1;for(const q of Z){const d=Math.min(...centers.map(c=>dist(q,c)));if(d>bd){bd=d;best=q}}centers.push([...best])}let labels=[];for(let it=0;it<100;it++){const nl=Z.map(q=>centers.map(c=>dist(q,c)).indexOf(Math.min(...centers.map(c=>dist(q,c)))));const nc=centers.map((c,j)=>{const pts=Z.filter((_,i)=>nl[i]===j);return pts.length?c.map((_,d)=>S.mean(pts.map(r=>r[d]))):c});if(labels.length&&nl.every((v,i)=>v===labels[i])){labels=nl;centers=nc;break}labels=nl;centers=nc}const inertia=Z.reduce((s,q,i)=>s+dist(q,centers[labels[i]])**2,0);const sizes=Array.from({length:k},(_,i)=>labels.filter(v=>v===i).length);return {task:'clustering',target:'None',features:enc.map(e=>e.name),model:'K-Means',trainSize:Z.length,testSize:0,metrics:{Clusters:k,Rows:Z.length,Inertia:inertia},examples:labels.slice(0,8).map((v,i)=>({actual:'Cluster '+(v+1),predicted:'Row '+(i+1)})),clusterSizes:sizes,reliable:true}}
window.renderMlPanel=function(){const body=document.getElementById('mlPanelBody');const candidates=STATE.columns.filter(c=>!c.looksId&&!c.constant&&(c.type==='numeric'||c.type==='categorical'||c.type==='boolean'));if(candidates.length<2||activeRows().length<20){body.innerHTML='<div class="empty-state"><h3>Machine Learning not recommended</h3><p>Need at least 20 rows and 2 usable columns.</p></div>';return}body.innerHTML=`<div class="card" style="margin-bottom:18px"><div class="grid cols-2"><div class="field"><label class="field-label">Machine Learning Mode</label><select class="pill-select" id="mlMode"><option value="supervised">Prediction / Supervised Learning</option><option value="clustering">Clustering / Unsupervised Learning</option></select></div><div class="field"><label class="field-label">Random Seed</label><input class="small-input" id="mlSeed" type="number" value="42"></div><div class="field" id="targetField"><label class="field-label">Target column</label><select class="pill-select" id="mlTarget">${candidates.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)} (${c.type})</option>`).join('')}</select></div><div class="field"><label class="field-label">Task / Algorithm</label><select class="pill-select" id="mlAlgorithm"></select></div><div class="field" id="splitField"><label class="field-label">Train / Test Split</label><select class="pill-select" id="mlSplit"><option value="0.8">80% / 20%</option><option value="0.75">75% / 25%</option><option value="0.7">70% / 30%</option></select></div><div class="field" id="kField" style="display:none"><label class="field-label">Number of Clusters</label><select class="pill-select" id="mlK"><option>2</option><option selected>3</option><option>4</option><option>5</option><option>6</option></select></div></div><div class="field"><label class="field-label">Feature columns</label><div class="tag-row" id="mlFeatures"></div></div><div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn primary" id="mlRunBtn">Train Model</button><button class="btn" id="mlCompareBtn">Compare Models</button></div></div><div id="mlResultWrap"></div>`;const mode=document.getElementById('mlMode'),target=document.getElementById('mlTarget'),alg=document.getElementById('mlAlgorithm'),feat=document.getElementById('mlFeatures');function refresh(){const clustering=mode.value==='clustering';document.getElementById('targetField').style.display=clustering?'none':'';document.getElementById('splitField').style.display=clustering?'none':'';document.getElementById('kField').style.display=clustering?'':'none';document.getElementById('mlCompareBtn').style.display=clustering?'none':'';const t=colMeta(target.value),task=t.type==='numeric'?'regression':'classification';const arr=clustering?['K-Means']:(task==='regression'?['Linear Regression','Decision Tree Regressor','Random Forest Regressor','KNN Regressor']:['Logistic Regression','Decision Tree Classifier','Random Forest Classifier','KNN Classifier','Naive Bayes','SVM']);alg.innerHTML=arr.map(a=>`<option>${a}</option>`).join('');feat.innerHTML=candidates.filter(c=>clustering||c.name!==target.value).map(c=>`<label style="display:flex;align-items:center;gap:5px;border:1px solid var(--line);border-radius:7px;padding:5px 9px;font-size:12px;cursor:pointer"><input type="checkbox" value="${escapeHtml(c.name)}" checked style="margin:0"> ${escapeHtml(c.name)}</label>`).join('')}mode.onchange=refresh;target.onchange=refresh;refresh();function selected(){return [...feat.querySelectorAll('input:checked')].map(x=>x.value)}document.getElementById('mlRunBtn').onclick=()=>{try{const fs=selected();if(!fs.length)throw Error('Select at least one feature.');const seed=Number(document.getElementById('mlSeed').value)||42,res=mode.value==='clustering'?runKMeansProfessional(fs,Number(document.getElementById('mlK').value),seed):runSupervised(target.value,fs,alg.value,Number(document.getElementById('mlSplit').value),seed);STATE.mlResult=res;renderMlResult(res)}catch(e){document.getElementById('mlResultWrap').innerHTML=`<div class="card"><h3>Model training unavailable</h3><p>${escapeHtml(e.message)}</p></div>`}};document.getElementById('mlCompareBtn').onclick=()=>{try{const fs=selected(),task=colMeta(target.value).type==='numeric'?'regression':'classification',arr=task==='regression'?['Linear Regression','Decision Tree Regressor','Random Forest Regressor','KNN Regressor']:['Logistic Regression','Decision Tree Classifier','Random Forest Classifier','KNN Classifier','Naive Bayes','SVM'];const seed=Number(document.getElementById('mlSeed').value)||42,split=Number(document.getElementById('mlSplit').value),results=[];for(const a of arr){try{results.push(runSupervised(target.value,fs,a,split,seed))}catch(e){results.push({model:a,error:e.message})}}const valid=results.filter(r=>!r.error),best=valid.sort((a,b)=>task==='regression'?b.metrics.R2-a.metrics.R2:b.metrics.Accuracy-a.metrics.Accuracy)[0];const wrap=document.getElementById('mlResultWrap');wrap.innerHTML=`<div class="card"><h3>Model Comparison</h3><p class="stat-sub">Best recommendation: <strong>${best?escapeHtml(best.model):'None'}</strong></p><div class="table-scroll"><table class="dl-table"><tr><th>Model</th><th>Primary Score</th><th>Status</th></tr>${results.map(r=>`<tr><td>${escapeHtml(r.model)}</td><td>${r.error?'—':fmtNum(task==='regression'?r.metrics.R2:r.metrics.Accuracy,4)}</td><td>${r.error?escapeHtml(r.error):'Ready'}</td></tr>`).join('')}</table></div></div>`}catch(e){document.getElementById('mlResultWrap').innerHTML=`<div class="card"><h3>Comparison unavailable</h3><p>${escapeHtml(e.message)}</p></div>`}}};
window.renderMlResult=function(res){const wrap=document.getElementById('mlResultWrap');const metrics=Object.entries(res.metrics).map(([k,v])=>`<div class="card stat-card"><div class="stat-label">${METRIC_LABELS[k]||k}</div><div class="stat-value" style="font-size:20px">${fmtNum(v,4)}</div></div>`).join('');const imp=res.importance?.length?`<div class="section-title"><h2>Feature Importance</h2></div><div class="table-scroll"><table class="dl-table"><tr><th>Feature</th><th>Importance</th></tr>${res.importance.slice(0,15).map(x=>`<tr><td>${escapeHtml(x.feature)}</td><td>${fmtNum(x.importance,4)}</td></tr>`).join('')}</table></div>`:'';const clusters=res.clusterSizes?`<div class="section-title"><h2>Cluster Distribution</h2></div><div class="tag-row">${res.clusterSizes.map((n,i)=>`<span class="badge">Cluster ${i+1}: ${n} rows</span>`).join('')}</div>`:'';const conf=res.task==='classification'?`<div class="section-title"><h2>Confusion Matrix</h2></div><div class="table-scroll"><table class="dl-table"><tr><th>Actual \\ Predicted</th>${res.classes.map(c=>`<th>${escapeHtml(c)}</th>`).join('')}</tr>${res.classes.map(a=>`<tr><td><strong>${escapeHtml(a)}</strong></td>${res.classes.map(b=>`<td>${res.confusion[a][b]||0}</td>`).join('')}</tr>`).join('')}</table></div>`:'';wrap.innerHTML=`<div class="card" style="margin-bottom:16px"><h3>${res.reliable?'Model Result Available':'Model Result: Use With Caution'}</h3><div class="tag-row" style="margin-top:10px"><span class="badge">Model: ${escapeHtml(res.model)}</span><span class="badge">Target: ${escapeHtml(res.target)}</span><span class="badge">Train: ${res.trainSize}</span><span class="badge">Test: ${res.testSize}</span><span class="badge">Features: ${res.features.length}</span></div></div><div class="grid cols-4">${metrics}</div>${imp}${clusters}${conf}<div class="section-title"><h2>Prediction Examples</h2></div><div class="table-scroll"><table class="dl-table"><tr><th>#</th><th>Actual / Cluster</th><th>Predicted / Row</th></tr>${res.examples.map((e,i)=>`<tr><td>${i+1}</td><td>${escapeHtml(String(e.actual))}</td><td>${escapeHtml(String(e.predicted))}</td></tr>`).join('')}</table></div>`};
})();
</script>
</body>
</html>
